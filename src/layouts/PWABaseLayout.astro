---
import '../styles/global.css'
import GoogleAnalytics from '../components/layout/head/GoogleAnalytics.astro'
import Fonts from '../components/layout/head/Fonts.astro'
import Footer from "../components/layout/footer/Footer.astro";
import PWANavigation from "../components/layout/navigation/PWANavigation.astro";
import { canonicalUrl } from '../lib/utils/canonical';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {title, description, canonical: propCanonical} = Astro.props;
const t = title || 'Jingle Jam Community';
const canonical = propCanonical ?? canonicalUrl(Astro.url)
---
<html lang="en">
<head>
    <GoogleAnalytics />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml"/>
    <meta charset="UTF-8"/>
    {description && <meta name="description" content={description} />}
    <meta name="viewport" content="width=device-width"/>
    <Fonts />
    <link rel="icon" type="image/svg+xml" href="/jj-favicon.svg"/>
    <link rel="shortcut icon" href="/favicon.ico"/>
    <meta name="apple-mobile-web-app-title" content="Jingle Jam"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <script is:inline src="/script.js" defer></script>
    <link rel="canonical" href={canonical}/>
    <meta name="generator" content={Astro.generator}/>
    <title>{t}</title>
</head>
