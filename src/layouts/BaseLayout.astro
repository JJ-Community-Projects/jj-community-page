---
import '../styles/global.css'
import GoogleAnalytics from '../components/layout/head/GoogleAnalytics.astro'
import Fonts from '../components/layout/head/Fonts.astro'
import Navigation from '../components/layout/navigation/Navigation.astro';
import Footer from "../components/layout/footer/Footer.astro";
import FeedbackBanner from "../components/features/feedback/FeedbackBanner.astro";
import AdminNavigation from "../components/layout/navigation/AdminNavigation.astro";
import { canonicalUrl, SITE_URL } from '../lib/utils/canonical';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  og?: {
    title?: string;
    description?: string;
    url?: string;
    image?: string;
    imageWidth?: string;
    imageHeight?: string;
  }
}

const {title, description, canonical: propCanonical, og: propOg} = Astro.props;
const t = title || 'Jingle Jam Community';
const canonical = propCanonical ?? canonicalUrl(Astro.url)

const og = {
  title: propOg?.title ?? title,
  description: propOg?.description ?? description,
  url: propOg?.url ?? canonical,
  image: propOg?.image ?? `${SITE_URL}/jj-og.png`,
  imageWidth: propOg?.imageWidth ?? '1200',
  imageHeight: propOg?.imageHeight ?? '630',
}

---
<html lang="en">
<head>
    <GoogleAnalytics />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml"/>
    <meta charset="UTF-8"/>
    {description && <meta name="description" content={description} />}
    <meta name="viewport" content="width=device-width"/>
    <Fonts />
    <link rel="icon" type="image/svg+xml" href="/jj-favicon.svg"/>
    <link rel="shortcut icon" href="/favicon.ico"/>
    <meta name="apple-mobile-web-app-title" content="Jingle Jam"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jingle Jam Community" />
    <meta property="og:title" content={og.title} />
    {og.description && <meta property="og:description" content={og.description} />}
    <meta property="og:url" content={og.url} />
    <meta property="og:image" content={og.image} />
    <meta property="og:image:width" content={og.imageWidth} />
    <meta property="og:image:height" content={og.imageHeight} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={og.title} />
    {og.description && <meta name="twitter:description" content={og.description} />}
    <meta name="twitter:image" content={og.image} />

    <script is:inline src="/script.js" defer></script>
    <link rel="canonical" href={canonical}/>
    <meta name="generator" content={Astro.generator}/>
    <title>{t}</title>
</head>
<body class="h-screen overflow-hidden bg-linear-to-br from-primary-shade via-primary to-primary-shade">
<div class="h-full overflow-y-auto p-2">
    <div class="flex flex-col justify-start min-h-screen">
        <div class="flex flex-col gap-2 items-center">
            <Navigation/>
            <AdminNavigation/>
        </div>
        <FeedbackBanner/>
        <div class="mt-4 mx-4 xl:mx-20 flex flex-col justify-start items-center">
            <slot/>
        </div>
    </div>
    <Footer/>
</div>
</body>
</html>
