<body
  class="h-screen overflow-hidden font-poppins bg-gradient-to-br from-primary-shade via-primary to-primary-shade"
>
  <div class="h-full overflow-y-auto p-2" style="overflow-anchor: none;">
    <div class="flex flex-col justify-start min-h-screen">
      <div class="flex flex-col gap-2 items-center mb-4">
        <Navigation />
        <AdminNavigation />
      </div>
      <FeedbackBanner />
      <div class="flex flex-col justify-start items-center min-h-screen">
        <div
          class="w-full max-w-4xl mx-auto flex flex-col justify-start items-stretch [&>*]:w-full"
        >
          <slot />
        </div>
      </div>
    </div>
    <Footer />
  </div>
</body>
