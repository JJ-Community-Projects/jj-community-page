import {
  BskyIcon,
  DiscordIcon,
  RedditIcon,
} from '../../common/icons/JJIcons.tsx'
---

<div class={'flex flex-row gap-4 p-2 text-white'}>
  <a
    class={'rounded-full transition-all hover:scale-110 hover:bg-white/10'}
    href={'https://discord.gg/D5eqweWQPs'}
  >
    <DiscordIcon class={'~size-4/6'}/>
  </a>
  <a
    class={'rounded-full transition-all hover:scale-110 hover:bg-white/10'}
    href={'https://bsky.app/profile/ostof.bsky.social'}
  >
    <BskyIcon class={'~size-4/6'}/>
  </a>
  <a
    class={'rounded-full transition-all hover:scale-110/10'}
    href={'mailto:ostof13@gmail.com'}
  >
    <FaSolidEnvelope class={'~size-4/6'}/>
  </a>
  <a
    class={'rounded-full transition-all hover:scale-110 hover:bg-white/10'}
    href={'https://old.reddit.com/message/compose/?to=Ostof'}
  >
    <RedditIcon class={'~size-4/6'}/>
