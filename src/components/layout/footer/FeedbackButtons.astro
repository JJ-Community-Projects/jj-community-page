---
import { FaSolidEnvelope } from 'solid-icons/fa'
import {
  BskyIcon,
  DiscordIcon,
  RedditIcon,
} from '../../common/icons/JJIcons.tsx'

const links = [
  { href: 'https://discord.gg/hBdKXkB', label: 'Feedback on Discord', Icon: DiscordIcon },
  { href: 'https://bsky.app/profile/ostof.bsky.social', label: 'Feedback on Bluesky', Icon: BskyIcon },
  { href: 'mailto:ostof13@gmail.com', label: 'Feedback by email', Icon: FaSolidEnvelope },
  { href: 'https://old.reddit.com/message/compose/?to=Ostof', label: 'Feedback on Reddit', Icon: RedditIcon },
]
---

<div class="flex flex-row gap-1 text-on-canvas">
  {
    links.map(({ href, label, Icon }) => (
      <a
        class="rounded-full p-2 transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        href={href}
        aria-label={label}
      >
        <Icon class="size-5" />
      </a>
    ))
  }
</div>
