---
import FeedbackButtons from './FeedbackButtons.astro'
import { getCollection } from 'astro:content'
import {
  BskyIcon,
  DiscordIcon,
  GithubIcon,
  InstagramIcon,
  TiktokIcon,
  TwitchIcon,
  TwitterIcon,
  YoutubeIcon,
} from '../../common/icons/JJIcons'

// Years with a visible Yogscast schedule, newest first (same rule as the /yogs hub)
const archiveYears = (await getCollection('schedules'))
  .filter((schedule) => schedule.data.visible && /^\d{4}$/.test(schedule.id))
  .map((schedule) => Number(schedule.id))
  .sort((a, b) => b - a)

const jjLinks = [
  { href: 'https://twitch.tv/team/jinglejam', label: 'Jingle Jam Stream Team', Icon: TwitchIcon },
  { href: 'https://www.youtube.com/@JingleJam', label: 'Jingle Jam Youtube', Icon: YoutubeIcon },
  { href: 'https://discord.gg/dsCsJJcvAx', label: 'Jingle Jam Discord', Icon: DiscordIcon },
  { href: 'https://bsky.app/profile/jinglejam.co.uk', label: 'Jingle Jam BlueSky', Icon: BskyIcon },
  { href: 'https://x.com/jinglejam', label: 'Jingle Jam Twitter', Icon: TwitterIcon },
  { href: 'http://instagram.com/jinglejamofficial', label: 'Jingle Jam Instagram', Icon: InstagramIcon },
  { href: 'http://tiktok.com/@jinglejamofficial', label: 'Jingle Jam Tiktok', Icon: TiktokIcon },
]

const focus =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'
---

<footer class="mt-10 border-t border-white/15 text-sm text-on-canvas-muted">
  <div class="mx-auto grid w-full max-w-6xl gap-6 px-4 py-6 md:grid-cols-3">
    <section class="flex flex-col gap-1">
      <h2 class="font-semibold text-on-canvas">About</h2>
      <p>
        jinglejam.ostof.dev is a site maintained by the community. You can see past Yogscast Jingle
        Jam Streams including links to the VODs. For more information about the Jingle Jam visit{' '}
        <a class="font-semibold text-on-canvas underline" href="https://jinglejam.co.uk">
          jinglejam.co.uk
        </a>.
      </p>
      <div class="-ml-2 flex flex-row flex-wrap text-on-canvas">
        {
          jjLinks.map(({ href, label, Icon }) => (
            <a
              class={`rounded-full p-2 transition-colors hover:bg-white/10 ${focus}`}
              href={href}
              target="_blank"
              aria-label={label}
            >
              <Icon class="size-5" />
            </a>
          ))
        }
      </div>
    </section>
    <section class="flex flex-col gap-1">
      <h2 class="font-semibold text-on-canvas">Send Feedback</h2>
      <p>Feedback is always appreciated.</p>
      <div class="-ml-2">
        <FeedbackButtons />
      </div>
    </section>
    <section class="flex flex-col gap-1">
      <h2 class="font-semibold text-on-canvas">Disclaimer</h2>
      <p>
        jinglejam.ostof.dev is a community project and <strong class="text-on-canvas"
          >not associated or endorsed</strong
        > by the Jingle Jam, the Yogscast or their partners.
      </p>
    </section>
  </div>
  <nav
    aria-label="Footer"
    class="mx-auto flex w-full max-w-6xl flex-col items-center gap-2 px-4 pb-6 text-center text-xs"
  >
    <div class="flex flex-row flex-wrap items-center justify-center gap-x-4 gap-y-1">
      <a class="hover:text-on-canvas hover:underline" href="/about">About</a>
      <a class="hover:text-on-canvas hover:underline" href="/faq">FAQ</a>
      <a class="hover:text-on-canvas hover:underline" href="/stream-resources">Stream Resources</a>
      <a class="hover:text-on-canvas hover:underline" href="/twitch-extension">Twitch Extension</a>
      <a class="hover:text-on-canvas hover:underline" href="/is-the-collection-live"
        >Is the Collection Live?</a
      >
    </div>
    {
      archiveYears.length > 0 && (
        <div class="flex flex-row flex-wrap items-center justify-center gap-x-4 gap-y-1">
          <span>Yogscast schedule archive:</span>
          {archiveYears.map((year) => (
            <a class="hover:text-on-canvas hover:underline" href={`/yogs/archive/${year}`}>
              Jingle Jam {year}
            </a>
          ))}
        </div>
      )
    }
    <a
      class="flex flex-row items-center gap-1 hover:text-on-canvas hover:underline"
      href="https://github.com/orgs/JJ-Community-Projects/repositories"
      target="_blank"
    >
      Contribute on GitHub
      <GithubIcon class="size-3.5" />
    </a>
  </nav>
</footer>
