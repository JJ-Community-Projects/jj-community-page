---
import {getCollection} from "astro:content";

const schedules = await getCollection('schedules');
const paths = schedules
  .filter((ref) => ref.data.visible)
  .map(entry => entry.id)
  .sort((a, b) => b.localeCompare(a));

---

<div class="hidden md:absolute md:z-50 md:group-hover:block">
    <div class="min-w-48 bg-accent/95 text-white rounded-xl shadow-2xl ring-1 ring-white/10 backdrop-blur-sm">
        <div class="flex flex-col text-center">
            <a class="nav bg-accent/95 hover:brightness-105 rounded-full p-1" href={`/yogs`}>Yogs</a>
          {paths.map(path => (<a class="nav bg-accent/95 hover:brightness-105 rounded-full p-1" href={`/yogs/archive/${path}`}>{path}</a>))}
            <a class="nav bg-accent/95 hover:brightness-105 rounded-full p-1" href={`/yogs/stats`}>Statistics</a>
        </div>
    </div>
</div>
