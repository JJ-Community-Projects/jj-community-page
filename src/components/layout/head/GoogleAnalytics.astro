---
import { env } from 'cloudflare:workers'

// SSR pages read the deployed Worker's vars per request. Prerendered pages (the archive years) are
// rendered at build time in the prerender worker, which gets the vars of the build's CLOUDFLARE_ENV,
// so `CLOUDFLARE_ENV=prod astro build` tags them and beta / local builds don't.
const isProd = env.ENVIRONMENT === 'PROD'
---

{
  isProd && (
    <script is:inline>
      // Only defines the loader: ConsentBanner.astro calls it once the visitor has accepted.
      window.startGoogleAnalytics = () => {
        if (window.gtag) return;
        window.dataLayer = window.dataLayer || [];

        function gtag() {
          dataLayer.push(arguments);
        }

        gtag('js', new Date());
        gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
        });
        gtag('config', 'G-P6MYGN62FW', {anonymize_ip: true, cookie_flags: 'max-age=7200;secure;samesite=none'});
        window.gtag = gtag;

        // gtag.js (~170 kB) loads after the page so it doesn't compete with the page's own requests.
        // Calls made before then wait in dataLayer, so the page view is still sent.
        const load = () => {
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=G-P6MYGN62FW';
          document.head.appendChild(script);
        };
        if (document.readyState === 'complete') load();
        else addEventListener('load', load, { once: true });
      };
    </script>
  )
}
