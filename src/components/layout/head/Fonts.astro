    font-display: swap;
  }

  @font-face {
    font-family: 'Poppins';
    src: url('../../../fonts/Poppins/Poppins-Thin.woff2') format('woff2');
    font-style: normal;
    font-weight: 100;
    font-display: swap;
  }

  @font-face {
    font-family: 'Poppins';
    src: url('../../../fonts/Poppins/Poppins-ThinItalic.woff2') format('woff2');
