---
import GoogleAnalytics from './GoogleAnalytics.astro'
import Fonts from './Fonts.astro'
import YogsJsonLd from '../../yogs-pages/common/YogsJsonLd.astro'
import type { JsonLd } from '../../../content/getJingleJamEventSeries.ts'
import { canonicalUrl, SITE_URL } from '../../../lib/utils/canonical'
import bebasUrl from '../../../fonts/BebasNeues/BebasNeue-Regular.woff2?url'
import { env } from 'cloudflare:workers'

export type OgProps = {
  title?: string
  description?: string
  url?: string
  image?: string
  imageWidth?: string
  imageHeight?: string
}

export interface Props {
  title?: string
  description?: string
  canonical?: string
  /** `<meta name="robots">`; omitted when unset (indexable). */
  robots?: string
  /** Open Graph + Twitter card overrides; `false` leaves the social tags out (PWA pages). */
  og?: OgProps | false
  /** Structured data (EventSeries, BreadcrumbList); undefined entries are skipped. */
  jsonLd?: (JsonLd | undefined)[]
  /** Preload Bebas, the Yogs grid's display font, so its swap doesn't shift the page. Only for pages that use it. */
  preloadDisplayFont?: boolean
}

const {
  title,
  description,
  canonical: propCanonical,
  robots,
  og: propOg,
  jsonLd,
  preloadDisplayFont,
} = Astro.props
const t = title || 'Jingle Jam Community'
const canonical = propCanonical ?? canonicalUrl(Astro.url)

const og = propOg !== false && {
  title: propOg?.title ?? title,
  description: propOg?.description ?? description,
  url: propOg?.url ?? canonical,
  image: propOg?.image ?? `${SITE_URL}/jj-og.png`,
  imageWidth: propOg?.imageWidth ?? '1200',
  imageHeight: propOg?.imageHeight ?? '630',
}

const isProd = env.ENVIRONMENT === 'PROD'
const { user } = Astro.locals
const isAdmin = user?.tiltifySlug === 'ostof'
const showAnalytics = isProd && !isAdmin
---

<head>
  {/* charset must be within the first 1024 bytes, so it goes before the inline scripts */}
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <script is:inline>
    // Theme before the first paint: localStorage.theme is 'light' or 'dark', absent means System.
    // ThemeSwitch.tsx writes the same key. Re-applied when the OS setting or another tab changes it.
    ;(() => {
      const media = matchMedia('(prefers-color-scheme: dark)')
      const apply = () => {
        let theme = null
        try {
          theme = localStorage.getItem('theme')
        } catch {}
        const dark = theme === 'dark' || (theme !== 'light' && media.matches)
        document.documentElement.dataset.theme = dark ? 'dark' : 'light'
      }
      apply()
      media.addEventListener('change', apply)
      addEventListener('storage', (e) => e.key === 'theme' && apply())
    })()
    // Yogs grid settings before the first paint: 'off' hides the background, stops its animation
    // or hides the avatars. ScheduleSettingsMenu.tsx writes the same keys.
    for (const key of ['yogs-bg', 'yogs-motion', 'yogs-avatars']) {
      try {
        if (localStorage.getItem(key) === 'off')
          document.documentElement.setAttribute(`data-${key}`, 'off')
      } catch {}
    }
  </script>
  {showAnalytics && (
    <>
      <script is:inline>
        // Only defines the loader: ConsentBanner.astro calls it once the visitor has accepted.
        // The tracker finds its settings through this id.
        window.startCounterscale = () => {
          if (document.getElementById('counterscale-script')) return
          const script = document.createElement('script')
          script.id = 'counterscale-script'
          script.dataset.siteId = 'jj-community-page'
          script.src = 'https://analytics.ostof.dev/tracker.js'
          document.head.appendChild(script)
        }
      </script>
      <GoogleAnalytics />
    </>
  )}
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  {description && <meta name="description" content={description} />}
  {robots && <meta name="robots" content={robots} />}
  {preloadDisplayFont && (
    <link
      rel="preload"
      href={bebasUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
  )}
  <Fonts />
  <link rel="icon" type="image/svg+xml" href="/jj-favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <meta name="apple-mobile-web-app-title" content="Jingle Jam" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />

  {og && (
    <>
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="Jingle Jam Community" />
      <meta property="og:title" content={og.title} />
      {og.description && (
        <meta property="og:description" content={og.description} />
      )}
      <meta property="og:url" content={og.url} />
      <meta property="og:image" content={og.image} />
      <meta property="og:image:width" content={og.imageWidth} />
      <meta property="og:image:height" content={og.imageHeight} />

      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={og.title} />
      {og.description && (
        <meta name="twitter:description" content={og.description} />
      )}
      <meta name="twitter:image" content={og.image} />
    </>
  )}

  {jsonLd && <YogsJsonLd data={jsonLd} />}

  <script is:inline src="/script.js" defer></script>
  <link rel="canonical" href={canonical} />
  <meta name="generator" content={Astro.generator} />
  <title>{t}</title>
</head>
