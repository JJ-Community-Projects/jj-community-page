---
import GoogleAnalytics from './GoogleAnalytics.astro'
import Fonts from './Fonts.astro'
import YogsJsonLd from '../../yogs-pages/common/YogsJsonLd.astro'
import type { JsonLd } from '../../../content/getJingleJamEventSeries.ts'
import { canonicalUrl, SITE_URL } from '../../../lib/utils/canonical'

export type OgProps = {
  title?: string
  description?: string
  url?: string
  image?: string
  imageWidth?: string
  imageHeight?: string
}

export interface Props {
  title?: string
  description?: string
  canonical?: string
  /** `<meta name="robots">`; omitted when unset (indexable). */
  robots?: string
  /** Open Graph + Twitter card overrides; `false` leaves the social tags out (PWA pages). */
  og?: OgProps | false
  /** Structured data (EventSeries, BreadcrumbList); undefined entries are skipped. */
  jsonLd?: (JsonLd | undefined)[]
}

const { title, description, canonical: propCanonical, robots, og: propOg, jsonLd } = Astro.props
const t = title || 'Jingle Jam Community'
const canonical = propCanonical ?? canonicalUrl(Astro.url)

const og = propOg !== false && {
  title: propOg?.title ?? title,
  description: propOg?.description ?? description,
  url: propOg?.url ?? canonical,
  image: propOg?.image ?? `${SITE_URL}/jj-og.png`,
  imageWidth: propOg?.imageWidth ?? '1200',
  imageHeight: propOg?.imageHeight ?? '630',
}
---

<head>
  <GoogleAnalytics />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <meta charset="UTF-8" />
  {description && <meta name="description" content={description} />}
  {robots && <meta name="robots" content={robots} />}
  <meta name="viewport" content="width=device-width" />
  <Fonts />
  <link rel="icon" type="image/svg+xml" href="/jj-favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <meta name="apple-mobile-web-app-title" content="Jingle Jam" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />

  {
    og && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Jingle Jam Community" />
        <meta property="og:title" content={og.title} />
        {og.description && <meta property="og:description" content={og.description} />}
        <meta property="og:url" content={og.url} />
        <meta property="og:image" content={og.image} />
        <meta property="og:image:width" content={og.imageWidth} />
        <meta property="og:image:height" content={og.imageHeight} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={og.title} />
        {og.description && <meta name="twitter:description" content={og.description} />}
        <meta name="twitter:image" content={og.image} />
      </>
    )
  }

  {jsonLd && <YogsJsonLd data={jsonLd} />}

  <script is:inline src="/script.js" defer></script>
  <link rel="canonical" href={canonical} />
  <meta name="generator" content={Astro.generator} />
  <title>{t}</title>
</head>
