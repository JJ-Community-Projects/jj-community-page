---
import { RedditIcon } from '../../common/icons/JJIcons.tsx'
import { cn, focusRing } from '../../ui/cn'

const href =
  'https://www.reddit.com/r/Yogscast/comments/1xkz72j/december_livestreams_suggestions_megathread/'

// Shown through Nov 30 (UTC); the megathread is for suggestions before December
const now = new Date()
const showUntil = new Date(`${now.getFullYear()}-12-01T00:00:00Z`)
const show = now < showUntil
---

{
  show && (
    <div class="mx-auto mb-3 flex w-fit max-w-full flex-wrap items-center justify-center gap-x-2 gap-y-0.5 rounded-group bg-surface-strong px-3 py-1.5 text-xs text-fg sm:text-sm">
      <RedditIcon class="size-4 shrink-0" />
      <span>Yogscast December Livestreams</span>
      <a
        href={href}
        target="_blank"
        rel="noopener"
        title="December Livestreams Suggestions Megathread"
        class={cn('font-semibold whitespace-nowrap underline', focusRing)}
      >
        Suggestions megathread
      </a>
    </div>
  )
}
