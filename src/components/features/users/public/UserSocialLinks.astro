---
interface Props {
  socials: {
    provider: string;
    url: string;
  }[];
}

const { socials } = Astro.props;

// Import social media components
import Twitch from "./social/Twitch.astro";
import Youtube from "./social/Youtube.astro";
import Twitter from "./social/Twitter.astro";
import Instagram from "./social/Instagram.astro";
import TikTok from "./social/TikTok.astro";
import BlueSky from "./social/BlueSky.astro";
import { GlobeIcon } from "../../../common/icons/JJIcons";

// Function to get display name based on provider
const getDisplayName = (provider: string) => {
  switch (provider.toLowerCase()) {
    case 'x':
      return 'Twitter';
    default:
      return provider.charAt(0).toUpperCase() + provider.slice(1);
  }
};
---

<div class="w-full bg-white rounded-lg p-6 mb-4 shadow-md">
  <h2 class="text-xl font-bold mb-4">Social Media</h2>
  {socials.length > 0 ? (
    <div class="flex flex-wrap justify-center gap-4">
      {socials.map((social) => {
        const provider = social.provider.toLowerCase();
        switch (provider) {
          case 'twitch':
            return <Twitch url={social.url} />;
          case 'youtube':
            return <Youtube url={social.url} />;
          case 'twitter':
          case 'x':
            return <Twitter url={social.url} />;
          case 'instagram':
            return <Instagram url={social.url} />;
          case 'tiktok':
            return <TikTok url={social.url} />;
          case 'bsky':
          case 'bluesky':
            return <BlueSky url={social.url} />;
          default:
            return (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center p-3 rounded-md bg-gray-300 hover:bg-gray-400 transition-colors"
              >
                <GlobeIcon class="text-gray-700" />
              </a>
            );
        }
      })}
    </div>
  ) : (
    <p class="text-gray-500">No social media links added yet</p>
  )}
</div>
