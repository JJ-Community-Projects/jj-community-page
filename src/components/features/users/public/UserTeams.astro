---
import { call, os } from '@orpc/server'
import {publicTeamsRouter} from "../../../../lib/orpc/public/teams/impl";

interface Props {
  tiltifyUsername: string;
  userId: number
}

const { tiltifyUsername, userId } = Astro.props;
const getTeamsByUserId = publicTeamsRouter.getTeamsByUserId
const result = await call(getTeamsByUserId, userId, {
  context: {
    locals: Astro.locals,
    request: Astro.request,
    env: Astro.locals.runtime.env
  }
})

const teams = result.teams;

---

<div class="w-full bg-white rounded-lg p-6 mb-4 shadow-md">
  <h2 class="text-xl font-bold mb-4">Teams</h2>
  {teams && teams.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {teams.map((team) => (
        <div class="border border-gray-200 rounded-md p-4">
          <div class="flex justify-between items-center mb-2">
            <h3 class="text-lg font-semibold">{team.name}</h3>
            {team.ownerId === userId && (
              <span class="text-xs bg-primary text-white px-2 py-1 rounded">
                Owner
              </span>
            )}
          </div>
          {team.description && (
            <p class="text-gray-600 text-sm mb-2">{team.description}</p>
          )}
          <a
            href={`/team/${team.slug}`}
            class="text-accent hover:underline inline-block mt-2"
          >
            View Team
          </a>
        </div>
      ))}
    </div>
  ) : (
    <p class="text-gray-500">Not a member of any public teams</p>
  )}
</div>
