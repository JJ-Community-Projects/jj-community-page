---
interface Props {
  tags: {
    userId: number;
    tag: string;
    label: string;
    addedAt: Date;
  }[];
}

const { tags } = Astro.props;

import Tag from "../../../common/Tag.astro";
---

<div class="w-full bg-white rounded-lg p-6 mb-4 shadow-md">
  <h2 class="text-xl font-bold mb-4">Tags</h2>
  {tags.length > 0 ? (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <Tag
          label={tag.label}
          tag={tag.tag}
          variant="default"
        />
      ))}
    </div>
  ) : (
    <p class="text-gray-500">No tags added yet</p>
  )}
</div>
