---
import {type Team} from "../../../../lib/orpc/public/schemas/teams";
import TeamsShowcaseItem from "./TeamsShowcaseItem.astro";

interface Props {
  teams: Team[];
  userColors: {
    primaryColor: string | null;
    accentColor: string | null;
  };
}

const {teams, userColors} = Astro.props;

// Get user colors with fallbacks to design system colors
const primaryColor = userColors.primaryColor || '#E30E50';
const accentColor = userColors.accentColor || '#3584BF';
---

<div class="bg-white rounded-xl shadow-md border-2 border-primary-200 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 mb-6 p-4 md:p-6 lg:p-8">
    <div class="flex items-center gap-3 mb-6">
        <div
                class="w-12 h-12 rounded-full flex items-center justify-center shadow-lg"
                style={`background: linear-gradient(135deg, ${primaryColor}, ${accentColor})`}
        >
            <svg
                    class="w-6 h-6 text-white"
                    fill="currentColor"
                    viewBox="0 0 24 24"
            >
                <path d="M12 5.9c1.16 0 2.1.94 2.1 2.1s-.94 2.1-2.1 2.1S9.9 9.16 9.9 8s.94-2.1 2.1-2.1m0 9c2.97 0 6.1 1.46 6.1 2.1v1.1H5.9V17c0-.64 3.13-2.1 6.1-2.1M12 4C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 9c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4z"/>
            </svg>
        </div>
        <div>
            <h2 class="~text-xl/2xl font-babas mb-1" style={`color: ${primaryColor}`}>
                Teams
            </h2>
            <p class="text-sm text-neutral-600 font-poppins">
                Team memberships and collaborations
            </p>
        </div>
    </div>

  {(teams && teams.length > 0) && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
            {teams.map((team) => (
                    <TeamsShowcaseItem team={team} userColors={userColors} />
            ))}
          </div>
    )}

  {!(teams && teams.length > 0) && (
          <div class="flex flex-col items-center justify-center py-12 text-center">
              <div
                      class="w-20 h-20 rounded-full flex items-center justify-center mb-6 shadow-lg"
                      style={`background: linear-gradient(135deg, ${primaryColor}20, ${accentColor}20)`}
              >
                  <svg
                          class="w-10 h-10"
                          style={`color: ${accentColor}`}
                          fill="currentColor"
                          viewBox="0 0 24 24"
                  >
                      <path d="M12 5.9c1.16 0 2.1.94 2.1 2.1s-.94 2.1-2.1 2.1S9.9 9.16 9.9 8s.94-2.1 2.1-2.1m0 9c2.97 0 6.1 1.46 6.1 2.1v1.1H5.9V17c0-.64 3.13-2.1 6.1-2.1M12 4C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 9c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4z"/>
                  </svg>
              </div>
              <h3 class="text-lg font-semibold text-neutral-700 mb-2 font-poppins">No team memberships</h3>
              <p class="text-neutral-500 font-poppins max-w-sm">
                  Team collaborations and memberships will appear here when joined
              </p>
          </div>
  )}
</div>
