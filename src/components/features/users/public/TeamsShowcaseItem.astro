---
import {type Team} from "../../../../lib/orpc/public/schemas/teams";

interface Props {
  team: Team;
  userColors: {
    primaryColor: string | null;
    accentColor: string | null;
  };
}

const {team, userColors} = Astro.props;

// Get user colors with fallbacks to design system colors
const primaryColor = userColors.primaryColor || '#E30E50';
const accentColor = userColors.accentColor || '#3584BF';
---
<article
        class="group relative bg-gradient-to-br from-white to-gray-50 border-2 border-gray-100 rounded-xl p-4 md:p-6 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 hover:border-primary-200">
    <div class="flex justify-between items-start mb-3">
        <h3 class="text-lg md:text-xl font-semibold font-poppins group-hover:font-bold transition-all duration-200"
            style={`color: ${primaryColor}`}>
          {team.name}
        </h3>
        <div class="px-2 py-1 text-xs font-medium rounded-full"
             style={`background-color: ${accentColor}15; color: ${accentColor}`}>
            Member
        </div>
    </div>
  {team.description && (
          <p class="text-neutral-600 text-sm mb-4 font-poppins leading-relaxed">
            {team.description.length > 120
              ? team.description.substring(0, 120) + '...'
              : team.description
            }
          </p>
  )}
    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
        <a
                href={`/teams/${team.slug}`}
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-all duration-200 transform hover:scale-105 active:scale-95 font-poppins"
                style={`background-color: ${accentColor}15; color: ${accentColor}; border: 1px solid ${accentColor}30`}
        >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            View Team
        </a>
        <div class="text-xs text-neutral-500 font-poppins">
            Team Profile
        </div>
    </div>
</article>
