---
interface Props {
  url: string;
  name?: string;
}

const { url, name = "Twitter" } = Astro.props;

import { TwitterIcon } from "../../../../common/icons/JJIcons";
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="flex flex-col items-center justify-center hover:scale-105 transition-all rounded-full p-2 hover:text-twitter hover:bg-twitter/10"
>
  <TwitterIcon class="size-6" />
  <p class="text-xxs">{name}</p>
</a>
