---
import Youtube from "./social/Youtube.astro";
import Twitter from "./social/Twitter.astro";
import Instagram from "./social/Instagram.astro";
import TikTok from "./social/TikTok.astro";
import BlueSky from "./social/BlueSky.astro";
import {GlobeIcon} from "../../../common/icons/JJIcons";
import Tag from "../../../common/Tag.astro";
import UserAvatar from "../../../common/UserAvatar";
import {TwitchLive} from "./social/TwitchLive";
import type {UserProfileData} from "../../../../lib/orpc/public/schemas/users";

interface Props {
  user: UserProfileData
}

const {user} = Astro.props;

const {user: {username}, tags, socials} = user


---

<div class="bg-white rounded-lg p-6 mb-4 shadow-md">
    <div class="flex flex-row items-center gap-4 mb-4 justify-center">
        <UserAvatar client:only="solid-js"  user={user} size="sm" />
        <h1 class="text-3xl font-bold text-primary">{username}</h1>
    </div>

    <div class="mt-4">
      {tags.length > 0 && (
              <div class="flex flex-wrap gap-2 justify-center">
                {tags.map((tag) => (
                  <Tag
                    label={tag.name}
                    tag={tag.slug}
                    variant="default"
                  />
                ))}
              </div>
      )}
    </div>

    <div class="mt-6">
      {socials && socials.length > 0 ? (
              <div class="flex flex-wrap justify-center items-start gap-4">
                {socials.map((social) => {
                  const provider = social.provider.toLowerCase();
                  switch (provider) {
                    case 'twitch':
                      return <TwitchLive client:only="solid-js" url={social.url} userId={user.id} />
                    case 'youtube':
                      return <Youtube url={social.url} name={provider.charAt(0).toUpperCase() + provider.slice(1)}/>;
                    case 'twitter':
                    case 'x':
                      return <Twitter url={social.url} name="Twitter"/>;
                    case 'instagram':
                      return <Instagram url={social.url} name={provider.charAt(0).toUpperCase() + provider.slice(1)}/>;
                    case 'tiktok':
                      return <TikTok url={social.url} name="TikTok"/>;
                    case 'bsky':
                    case 'bluesky':
                      return <BlueSky url={social.url} name="BlueSky"/>;
                    default:
                      return (
                              <a
                                      href={social.url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="flex flex-col items-center justify-center hover:scale-105 transition-all rounded-full p-2 hover:text-[#000000] hover:bg-[#000000]/10"
                              >
                                  <GlobeIcon class="size-6"/>
                                  <p class="text-xxs">{provider.charAt(0).toUpperCase() + provider.slice(1)}</p>
                              </a>
                      );
                  }
                })}
              </div>
      ) : (
              <p class="text-gray-500 text-center">No social media links added yet</p>
      )}
    </div>
</div>
