---
import { type ScheduleInfo } from '../../../../lib/orpc/public/schemas/schedules'
import { FaSolidCalendarDays, FaSolidChevronRight } from 'solid-icons/fa'
import { Section } from '../../../ui/Tile'
import { Chip } from '../../../ui/Labels'

interface Props {
  schedules: ScheduleInfo[]
}

const { schedules } = Astro.props
---

<Section title="Schedules">
  <FaSolidCalendarDays slot="icon" />
  <div class="flex flex-col gap-2">
    {
      schedules.map((schedule) => (
        <a
          href={`/schedules/${schedule.slug}`}
          class="flex items-center gap-2 rounded-group bg-surface-strong p-2 pl-3 ring-1 ring-line transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <h3 class="min-w-0 flex-1 truncate text-sm font-semibold">{schedule.title}</h3>
          <Chip size="sm" tone="primary">{schedule.year}</Chip>
          <FaSolidChevronRight class="size-3 shrink-0 text-fg-muted" aria-hidden="true" />
        </a>
      ))
    }
  </div>
</Section>
