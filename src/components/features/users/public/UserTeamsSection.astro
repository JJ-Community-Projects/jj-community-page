---
import {type Team} from "../../../../lib/orpc/public/schemas/teams";

interface Props {
  teams: Team[];
  userColors?: {
    primaryColor: string | null;
    accentColor: string | null;
  };
}

const {teams, userColors} = Astro.props;

// Get user colors with fallbacks to design system colors (optional for backward compatibility)
const primaryColor = userColors?.primaryColor || '#E30E50';
const accentColor = userColors?.accentColor || '#3584BF';
---

<div class="w-full bg-white rounded-xl shadow-md border-2 border-primary-200 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 mb-6 p-4 md:p-6 lg:p-8">
  <div class="flex flex-col items-center text-center mb-6">
    <div class="flex items-center gap-3 mb-2">
      <svg class="w-5 h-5 text-black" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 5.9c1.16 0 2.1.94 2.1 2.1s-.94 2.1-2.1 2.1S9.9 9.16 9.9 8s.94-2.1 2.1-2.1m0 9c2.97 0 6.1 1.46 6.1 2.1v1.1H5.9V17c0-.64 3.13-2.1 6.1-2.1M12 4C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 9c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4z"/>
      </svg>
      <h2 class="text-xl font-bold text-black font-babas">Teams</h2>
    </div>
  </div>
  {teams && teams.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {teams.map((team) => (
                    <div class="border border-gray-200 rounded-md p-4">
                        <div class="flex justify-between items-center mb-2">
                            <h3 class="text-lg font-semibold">{team.name}</h3>
                        </div>
                      {team.description && (
                              <p class="text-gray-600 text-sm mb-2">{team.description}</p>
                      )}
                        <a
                                href={`/team/${team.slug}`}
                                class="text-accent hover:underline inline-block mt-2"
                        >
                            View Team
                        </a>
                    </div>
            ))}
          </div>
  ) : (
          <p class="text-gray-500">Not a member of any public teams</p>
  )}
</div>
