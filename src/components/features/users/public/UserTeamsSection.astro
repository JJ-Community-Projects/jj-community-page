---
import { type Team } from '../../../../lib/orpc/public/schemas/teams'
import { FaSolidUsers } from 'solid-icons/fa'
import { Section } from '../../../ui/Tile'
import { TeamCard } from '../../teams/public/TeamCard'

interface Props {
  teams: Team[]
}

const { teams } = Astro.props
---

<Section title="Teams">
  <FaSolidUsers slot="icon" />
  <div class="grid gap-2 sm:grid-cols-2">
    {teams.map((team) => <TeamCard team={team} level={3} />)}
  </div>
</Section>
