---
import { getCollection, render } from 'astro:content'
import { FaSolidChevronDown } from 'solid-icons/fa'

// Each question is a tile that opens in place (native <details>, no JS); answers stay in the HTML.
const groups = ['other', 'community']
const faqs = (await getCollection('faq')).sort(
  (a, b) =>
    groups.findIndex((group) => a.id.includes(group)) -
      groups.findIndex((group) => b.id.includes(group)) || a.id.localeCompare(b.id),
)
---

<div class="flex flex-col gap-2">
  {
    faqs.map(async (faq) => {
      const { Content } = await render(faq)
      return (
        <details class="group rounded-tile bg-linear-to-b from-surface to-surface-2 text-fg shadow-tile ring-1 ring-line">
          <summary class="flex cursor-pointer list-none items-center gap-3 rounded-tile px-4 py-3 font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
            <span class="min-w-0 flex-1">{faq.data.question}</span>
            <FaSolidChevronDown
              class="size-3.5 shrink-0 text-fg-muted transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <div class="prose prose-sm max-w-none px-4 pb-4 text-fg-muted prose-a:font-medium prose-a:text-fg">
            <Content />
          </div>
        </details>
      )
    })
  }
</div>
