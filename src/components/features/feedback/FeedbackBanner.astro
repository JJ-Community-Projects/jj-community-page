---
import { FaSolidEnvelope } from 'solid-icons/fa'
import { DiscordIcon, RedditIcon } from '../../common/icons/JJIcons'
import { Button } from '../../ui/Button'

const now = new Date();
const year = now.getFullYear();
const showStart = new Date(`${year}-11-28T00:00:00Z`);
const showEnd = new Date(`${year}-12-31T00:00:00Z`);
const showBanner = now > showStart && now < showEnd;
---
{
  showBanner && (
    <div
      id={`feedback-${year}-banner`}
      class="mx-auto mt-3 hidden w-[calc(100%-1rem)] max-w-xl flex-wrap items-center gap-x-3 gap-y-1 rounded-tile bg-linear-to-b from-surface to-surface-2 p-3 text-fg shadow-tile ring-1 ring-line"
    >
      <p class="min-w-0 flex-1 basis-60 text-sm">
        <strong>Feedback?</strong>{' '}
        <span class="text-fg-muted">
          Tell us what you think about this site or the stream resources.
        </span>
      </p>
      <div class="flex items-center gap-1">
        <a
          class="rounded-full p-2 text-fg-muted transition-colors hover:bg-black/5 hover:text-fg"
          href="mailto:ostof13@gmail.com"
          aria-label="Feedback by email"
        >
          <FaSolidEnvelope class="size-4" />
        </a>
        <a
          class="rounded-full p-2 text-fg-muted transition-colors hover:bg-black/5 hover:text-discord"
          href="https://discord.gg/hBdKXkB"
          aria-label="Feedback on Discord"
        >
          <DiscordIcon class="size-4" />
        </a>
        <a
          class="rounded-full p-2 text-fg-muted transition-colors hover:bg-black/5 hover:text-reddit"
          href="https://old.reddit.com/message/compose/?to=Ostof"
          aria-label="Feedback on Reddit"
        >
          <RedditIcon class="size-4" />
        </a>
        <Button id={`feedback-${year}-banner-banner-got-it`} size="sm" variant="accent">
          Got it
        </Button>
      </div>
    </div>
  )
}

<script is:inline>
  const now = new Date();
  const year = now.getFullYear();
  const feedbackLocalstorage = window.localStorage;
  const button = document.getElementById(`feedback-${year}-banner-banner-got-it`);

  const shouldShow = feedbackLocalstorage.getItem(`feedback-${year}-banner`) ?? 'true';
  if (shouldShow === 'true') {
    const banner = document.getElementById(`feedback-${year}-banner`)
    if (banner) {
      banner.classList.remove('hidden');
      banner.classList.add('flex');
    }
    // The banner (and its button) is only rendered in some periods; gtag only exists on prod
    button?.addEventListener('click', () => {
      feedbackLocalstorage.setItem(`feedback-${year}-banner`, 'false');
      document.getElementById(`feedback-${year}-banner`)?.remove();
      window.gtag?.('event', 'dismiss_' + `feedback-${year}-banner`);
    });
  }
</script>
