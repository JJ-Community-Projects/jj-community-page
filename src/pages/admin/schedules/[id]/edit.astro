---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {ScheduleEditorComponent} from '../../../../components/features/users/admin/schedules/editor/ScheduleEditorComponent'

const {session, user} = Astro.locals;
if (session === null) {
  return Astro.redirect("/login");
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/");
}

// Check if the user owns this schedule or has edit permissions
// This is a simplified check - in a real app, you'd want to verify ownership in the database
// For now, we'll assume the user has permission if they're logged in
---

<BaseLayout>
  <div class="container mx-auto px-4 py-8">
      <ScheduleEditorComponent client:only="solid-js" scheduleId={parseInt(id)} userId={user.id} username={user.tiltifyName} />
  </div>
</BaseLayout>
