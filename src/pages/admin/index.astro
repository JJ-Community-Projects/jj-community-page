---
import {AdminDashboard} from "../../components/features/admin/AdminDashboard";
import PageShell from '../../layouts/PageShell.astro'
import {serverClientPrivate} from "../../lib/orpc/serverClient";



const {session, user} = Astro.locals
if (session === null) {
  return Astro.redirect("/");
}
const isAdmin = serverClientPrivate.users.isAdmin
const {data, error} = await isAdmin({}, {
  context: {
    locals: Astro.locals,
    request: Astro.request,
  },
})

if (error) {
  console.log(error)
  return Astro.redirect("/");
}

if (!data) {
  return Astro.redirect("/");
}


---

<PageShell width="wide">
    <AdminDashboard client:only="solid-js"/>
</PageShell>
