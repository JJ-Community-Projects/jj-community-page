---
import PageShell from '../layouts/PageShell.astro'
import { PageHeader } from '../components/ui/PageHeader'
import { Tile } from '../components/ui/Tile'

const link = 'font-medium underline'
---

<PageShell
  title="About the Jingle Jam Community Site"
  description="What the Jingle Jam Community site is: a fan-run hub for the Yogscast schedule, past streams with VODs, community fundraisers and streamer tools. Not official."
  canonical="https://jinglejam.ostof.dev/about"
>
  <div class="flex flex-col gap-3">
    <PageHeader title="About the Jingle Jam Community Site" />
    <Tile>
      <div class="flex max-w-prose flex-col gap-3 text-sm sm:text-base">
        <p>
          jinglejam.ostof.dev is a site maintained by the community. You can see the
          <a class={link} href="/yogs">Yogscast Jingle Jam schedule</a> and past Yogscast Jingle
          Jam streams including links to the VODs, <a class={link} href="/community"
            >community fundraisers</a
          > and <a class={link} href="/stream-resources">resources for streamers</a>. Questions are
          answered in the <a class={link} href="/faq">FAQ</a>.
        </p>
        <p>
          <strong>
            For more information about the Jingle Jam visit{' '}
            <a class={link} href="https://jinglejam.co.uk">jinglejam.co.uk</a>.
          </strong>
        </p>
      </div>
    </Tile>
  </div>
</PageShell>
