---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { FundraisersByTeamOverlay } from '../../components/features/overlay/ticker/fundraisers/FundraisersByTeamOverlay.tsx'

const teamParam = Astro.url.searchParams.get('team')
const themeParam = Astro.url.searchParams.get('theme')
const speedParam = Astro.url.searchParams.get('speed')
const showRaisedParam = Astro.url.searchParams.get('showraised')
const currencyParam = Astro.url.searchParams.get('currency')
const userParam = Astro.url.searchParams.get('user')

const team = teamParam ?? undefined
const theme = (themeParam as any) ?? undefined
const speed = speedParam ? Number(speedParam) : undefined
const showRaised = showRaisedParam === '1' || showRaisedParam === 'true' || showRaisedParam === null ? true : false
const currency = (() => { const v = (currencyParam ?? 'GBP').toUpperCase(); return v === 'USD' ? 'USD' : v === 'EUR' ? 'EUR' : 'GBP' })()
const user = userParam ?? undefined
---

<div class="min-h-screen bg-transparent text-white">
  <FundraisersByTeamOverlay client:only="solid-js" teamSlug={team} theme={theme} speed={speed} showRaised={showRaised} currency={currency} user={user} />
</div>
