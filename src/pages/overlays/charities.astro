---
import { CharitiesTickerOverlay } from '../../components/features/overlay/ticker/charities/CharitiesTickerOverlay.tsx'
import { serverClientPublic } from '../../lib/orpc/serverClient'

const { data: contentHidden } = await serverClientPublic.overlays.visibility.getHidden(
  {},
  {
    context: {
      locals: Astro.locals,
      request: Astro.request,
    },
  },
)
const HIDE_CONTENT = contentHidden ?? true

const themeParam = Astro.url.searchParams.get('theme')
const speedParam = Astro.url.searchParams.get('speed')
const currencyParam = Astro.url.searchParams.get('currency')
const userParam = Astro.url.searchParams.get('user')
const demoParam = Astro.url.searchParams.get('demo')

const theme = (themeParam as any) ?? undefined
const speed = speedParam ? Number(speedParam) : undefined
const currency = (() => { const v = (currencyParam ?? 'GBP').toUpperCase(); return v === 'USD' ? 'USD' : v === 'EUR' ? 'EUR' : 'GBP' })()
const user = userParam ?? undefined
const demo = demoParam === 'true' || demoParam === '1'

---
<div class="min-h-screen bg-transparent text-white">
  {HIDE_CONTENT ? (
    <p class="bg-black/70 p-4 text-center text-sm text-white/60">Overlay currently unavailable</p>
  ) : (
    <CharitiesTickerOverlay client:only="solid-js" theme={theme} speed={speed} currency={currency} user={user} demo={demo} />
  )}
</div>
