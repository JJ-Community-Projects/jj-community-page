---
import PageShell from '../../layouts/PageShell.astro'
import { OverlayConfiguration } from '../../components/features/overlay/overview/OverlayConfiguration.tsx'
import { PageHeader } from '../../components/ui/PageHeader'
import { Tile } from '../../components/ui/Tile'
import { JJStartCountdown } from '../../components/ui/Countdown'
import { serverClientPublic } from '../../lib/orpc/serverClient'

const { data: contentHidden } = await serverClientPublic.overlays.visibility.getHidden(
  {},
  {
    context: {
      locals: Astro.locals,
      request: Astro.request,
    },
  },
)
const HIDE_CONTENT = contentHidden ?? true

const user = Astro.locals.user
---

<PageShell width="wide"
  title="Jingle Jam Community OBS Overlays"
  description="Configure your Overlay V2 links and copy ready-to-use URLs for OBS browser sources."
  canonical="https://jinglejam.ostof.dev/overlays"
>
  <div class="flex w-full flex-col gap-3">
    <PageHeader
      title="JJ Community OBS Overlays"
      subtitle={HIDE_CONTENT
        ? 'Overlays are currently unavailable. They will be back when the Jingle Jam starts!'
        : 'Overlays for OBS browser sources: set one up below, copy its link and add it as a browser source. Feedback is appreciated!'}
    />
    {HIDE_CONTENT ? (
      <Tile class="flex flex-col items-center gap-4 text-center">
        <p class="max-w-2xl text-sm sm:text-base">
          The overlays show the Jingle Jam charities, community fundraisers, donation matches and your
          stream schedule in OBS browser sources.
        </p>
        <JJStartCountdown client:only="solid-js" />
      </Tile>
    ) : (
      <OverlayConfiguration client:only="solid-js" user={user} level={2} />
    )}
  </div>
</PageShell>
