---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {OverlayConfiguration} from '../../components/features/overlay/overview/OverlayConfiguration.tsx'

const user = Astro.locals.user
if (!user) {
  return Astro.redirect('/login')
}

---
<BaseLayout
  title="Jingle Jam Community OBS Overlays"
  description="Configure your Overlay V2 links and copy ready-to-use URLs for OBS browser sources."
  canonical="https://jinglejam.ostof.dev/overlays-v2"
>
  <div class="mx-auto flex w-fit flex-col items-center p-1 text-center text-base text-white md:w-[50%] md:text-2xl">
    <p class="p-1 text-2xl font-bold md:p-2 md:text-4xl">JJ Community OBS Overlays</p>
    <p>
      These overlays are designed for OBS browser sources. Configure your overlay below and copy the generated link.
    </p>
    <p class="text-xl font-bold">Feedback is appreciated!</p>
  </div>
  <OverlayConfiguration client:only="solid-js" user={user} />
</BaseLayout>
