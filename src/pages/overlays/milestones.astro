---
import '../../styles/global.css'
import {
  MilestonesOverlay,
  parseBarStyle,
} from '../../components/features/overlay/milestones/MilestonesOverlay.tsx'
import {
  BG_PRESETS,
  type BgPreset,
} from '../../components/features/overlay/donationMatches/presets.ts'
import {
  ITEM_PARAM,
  parseAmount,
  parseFlag,
  parseItems,
  parseOrder,
  parseShowCount,
} from '../../components/features/overlay/goals/goalItems.ts'
import { serverClientPublic } from '../../lib/orpc/serverClient'

const { data: contentHidden } =
  await serverClientPublic.overlays.visibility.getHidden(
    {},
    {
      context: {
        locals: Astro.locals,
        request: Astro.request,
      },
    },
  )
const HIDE_CONTENT = contentHidden ?? true

const params = Astro.url.searchParams
const themeParam = params.get('theme')
const theme: BgPreset =
  themeParam && themeParam in BG_PRESETS ? (themeParam as BgPreset) : 'red'
const currency = (() => {
  const v = (params.get('currency') ?? 'GBP').toUpperCase()
  return v === 'USD' ? 'USD' : v === 'EUR' ? 'EUR' : 'GBP'
})()
const user = params.get('user') ?? undefined
const order = parseOrder(params.get('order'))
const show = parseShowCount(params.get('show'))
const bar = parseFlag(params.get('bar'), true)
const barStyle = parseBarStyle(params.get('barStyle'))
const crossOut = parseFlag(params.get('crossOut'), true)
const itemBg = parseFlag(params.get('itemBg'), true)
const title = (params.get('title') ?? '').slice(0, 40)
const items = parseItems(params.getAll(ITEM_PARAM))
const demoRaised = parseAmount(params.get('demoRaised') ?? '')
---

<div class="min-h-screen bg-transparent text-white">
  {HIDE_CONTENT ? (
    <p class="bg-black/70 p-4 text-center text-sm text-white/60">
      Overlay currently unavailable
    </p>
  ) : (
    <MilestonesOverlay
      client:only="solid-js"
      user={user}
      theme={theme}
      currency={currency}
      order={order}
      show={show}
      bar={bar}
      barStyle={barStyle}
      crossOut={crossOut}
      itemBg={itemBg}
      title={title}
      items={items}
      demoRaised={demoRaised}
    />
  )}
</div>
