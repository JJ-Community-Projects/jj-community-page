---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {CharitiesOverlay} from '../../components/features/overlay/charities/CharitiesOverlay.tsx'

const headers = Astro.url.searchParams.getAll('header')
const includeTotalsParam = Astro.url.searchParams.get('includeTotals')
const themeParam = Astro.url.searchParams.get('theme')
const headerThemeParam = Astro.url.searchParams.get('headerTheme')
const showDescParam = Astro.url.searchParams.get('showDesc')
const qrCodeParam = Astro.url.searchParams.get('qrCode')
const showUrlParam = Astro.url.searchParams.get('showUrl')
const causesParam = Astro.url.searchParams.get('causes')
const currencyParam = Astro.url.searchParams.get('currency')
const user = Astro.url.searchParams.get('user') ?? undefined

const includeTotals = includeTotalsParam === 'true' || includeTotalsParam === '1'
const theme = themeParam ?? undefined
const headerTheme = headerThemeParam ?? undefined
const showDesc = showDescParam === 'true' || showDescParam === '1'
const qrCode = (() => {
  const v = (qrCodeParam ?? 'none').toLowerCase()
  return v === 'charity' || v === 'fundraiser' ? v : 'none'
})()
const currency = (() => {
  const v = (currencyParam ?? 'GBP').toUpperCase()
  return v === 'USD' ? 'USD' : v === 'EUR' ? 'EUR' : 'GBP'
})()
const showUrl = showUrlParam === undefined ? undefined : (showUrlParam === 'true' || showUrlParam === '1')
const causes = causesParam
  ? causesParam.split(',').map((s) => Number(s.trim())).filter((n) => !Number.isNaN(n))
  : undefined
---
  <div class="h-screen bg-transparent text-white">
    <CharitiesOverlay client:only="solid-js" headers={headers} includeTotals={includeTotals} theme={theme} headerTheme={headerTheme} showDesc={showDesc} qrCode={qrCode} currency={currency} showUrl={showUrl} causes={causes} user={user} />
  </div>
