---
import { getEntry } from 'astro:content'
export const prerender = false
import BaseLayout from '../../layouts/BaseLayout.astro'
import { CommunityPage } from '../../components/features/community/CommunityPage.tsx'
import {
  MainCountdownSimple,
  MainJJStartTimes,
} from '../../components/common/ui/MainHeader.tsx'
import { serverClientPublic } from '../../lib/orpc/serverClient'
import { getConfigYear } from '../../lib/utils/configYear'
import { upcomingJJYear } from '../../lib/utils/jjYear'

const [{ data: contentHidden }, configYear] = await Promise.all([
  serverClientPublic.overlays.visibility.getHidden(
    {},
    {
      context: {
        locals: Astro.locals,
        request: Astro.request,
      },
    },
  ),
  getConfigYear(),
])
const HIDE_CONTENT = contentHidden ?? true
const year = upcomingJJYear(configYear, HIDE_CONTENT)

const charityData = await getEntry('charities', '2025')

// The tag search gets the catalog from the page (no public HTTP route)
const tagCatalog = HIDE_CONTENT
  ? undefined
  : (
      await serverClientPublic.tags.catalog(
        {},
        { context: { locals: Astro.locals, request: Astro.request } },
      )
    ).data?.tags
---

<BaseLayout
  title={`Jingle Jam ${year} Community Fundraisers & Upcoming Streams`}
  description={`Community fundraisers and upcoming streams for Jingle Jam ${year}: fundraiser totals, who is streaming next, and links to donate. Community-run, not official.`}
  canonical="https://jinglejam.ostof.dev/community"
>
  {HIDE_CONTENT ? (
    <div class="flex w-full flex-col items-center gap-1 rounded-xl border border-white/10 bg-white/5 p-4 text-center text-white text-white/90 sm:p-4">
      <div class="flex flex-col items-center justify-center text-white">
        <h1 class="w-full text-center ~text-2xl/4xl">Jingle Jam {year} Community Fundraisers & Streams</h1>
        <h2 class="text-center ~text-lg/xl">
          Coming soon for the next Jingle Jam!
        </h2>
        <p class="mt-2 max-w-2xl text-center text-white/90">
          On the first day of Jingle Jam {year} (1 December) this page starts listing the community
          fundraisers with their totals and the community streams coming up next. Until then, see the{' '}
          <a class="underline" href="/yogs">Yogscast Jingle Jam schedule</a>.
        </p>
      </div>
      <div class="w-full">
        <MainCountdownSimple client:only="solid-js" />
      </div>
      <div class="w-full">
        <MainJJStartTimes client:only="solid-js" />
      </div>
    </div>
  ) : (
    <div class="w-full flex flex-col justify-center items-stretch gap-4">
      <h1 class="w-full text-center text-white ~text-2xl/4xl">Jingle Jam {year} Community Fundraisers & Streams</h1>
      <CommunityPage
        charitiesData={charityData?.data}
        tagCatalog={tagCatalog}
        client:only="solid-js" />
    </div>
  )}
</BaseLayout>
