---
import { getEntry } from 'astro:content'
export const prerender = false
import BaseLayout from '../../layouts/BaseLayout.astro'
import { CommunityPage } from '../../components/features/community/CommunityPage.tsx'
const charityData = await getEntry('charities', '2025')
---

<BaseLayout
  title="The Jingle Jam Community - Fundraiserss & Upcoming Streams"
  description="Explore community fundraisers and upcoming streams for Jingle Jam 2025 - discover creators and donate."
  canonical="https://jinglejam.ostof.dev/community"
>
  <div class="w-full flex flex-col justify-center items-stretch gap-4">
    <CommunityPage
      charitiesData={charityData?.data}
      client:only="solid-js" />
  </div>
</BaseLayout>
