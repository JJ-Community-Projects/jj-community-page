---
import { serverClientPrivate, serverClientPublic } from '../../lib/orpc/serverClient.ts'
import PageShell from '../../layouts/PageShell.astro'
import { CommunityPage } from '../../components/features/community-ssr/CommunityPage.tsx'
import { PageHeader } from '../../components/ui/PageHeader'

export const prerender = false
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=600'
)
// Server-side load initial data via orpc server client
const communityListFn = serverClientPrivate.jj.communityList
const upcomingStreamsFn = serverClientPrivate.jj.upcomingStreams

const ctx = {
  context: {
    locals: Astro.locals,
    request: Astro.request,
  },
}

const [
  { data: community },
  { data: upcomingStreams },
  { data: tagCatalog },
] = await Promise.all([
  communityListFn({}, ctx),
  upcomingStreamsFn({}, ctx),
  // The tag search gets the catalog from the page (no public HTTP route)
  serverClientPublic.tags.catalog({}, ctx),
])
---

<PageShell width="wide"
  title="The Jingle Jam Community - Fundraisers & Upcoming Streams"
  description="Explore community fundraisers and upcoming streams for Jingle Jam 2025 - discover creators and donate."
  canonical="https://jinglejam.ostof.dev/community"
>
  <div class="flex flex-col gap-3">
    <PageHeader title="Community" subtitle="Fundraisers and upcoming streams" />
    <CommunityPage initial={{ community, upcomingStreams }} tagCatalog={tagCatalog?.tags} client:idle />
  </div>
</PageShell>
