---
import { serverClientPublic } from '../../lib/orpc/serverClient'
import { UserHeaderLinks } from '../../components/features/users/public/UserHeader'
import { NextStreamsSection } from '../../components/features/users/public/NextStreamsSection'
import { FriendsSection } from '../../components/features/users/public/FriendsSection'
import { RelatedSection } from '../../components/features/users/public/RelatedSection'
import UserTeamsSection from '../../components/features/users/public/UserTeamsSection.astro'
import OtherSchedulesSection from '../../components/features/users/public/OtherSchedulesSection.astro'
import { ORPCError, ValidationError } from '@orpc/server'
import PageShell from '../../layouts/PageShell.astro'
import { Alert } from '../../components/ui/Status'
import { Tile } from '../../components/ui/Tile'
import { isNotFoundError } from '../../lib/utils/notFound'

const { username } = Astro.params

if (!username) {
  return Astro.redirect('/user-not-found')
}

// The catch-all also gets every unmatched path; a slug never contains a slash.
if (username.includes('/')) {
  return Astro.rewrite('/404')
}

const usernameLower = username.toLowerCase()

if (username !== usernameLower) {
  return Astro.redirect(`/${usernameLower}`)
}

const getUserFullProfileBySlug =
  serverClientPublic.users.getUserFullProfileBySlug

const { data: user, error } = await getUserFullProfileBySlug(
  { slug: username },
  {
    context: {
      locals: Astro.locals,
      request: Astro.request,
    },
  },
)

// Unknown, invalid or hidden user: a real 404, not a 200 with the error shown.
if (isNotFoundError(error)) {
  return Astro.rewrite('/404')
}

if (error) {
  Astro.response.status = 500
  console.error(error)
  if (error instanceof ORPCError) {
    console.error('ORPCError')
    const cause = error.cause
    console.error('Cause', cause)
    if (cause instanceof ValidationError) {
      console.error('ValidationError')
      const issues = cause.issues
      for (const issue of issues) {
        console.error('Issue', issue)
      }
    }
  } else if (error instanceof ValidationError) {
    console.error('ValidationError')
  }
}
if (user !== undefined) {
  //   throw Astro.redirect('/user-not-found')
  // console.log(JSON.stringify(user, null, 2))
}

// Fetch the user's primary schedule for the ActiveSchedule component
// const { data: primarySchedule, error: scheduleError } = await Astro.callAction(actions.ui.users.schedules.getCurrentPrimaryByTiltifyUsername, username);

// Title and description from the profile; the year is the one of the user's primary schedule
const name = user?.user.username
const scheduleYear = user?.primarySchedule?.year
const pageTitle = !name
  ? 'Profile | Jingle Jam Community'
  : scheduleYear
    ? `${name} - Jingle Jam ${scheduleYear} Schedule | Jingle Jam Community`
    : `${name} - Jingle Jam Streams | Jingle Jam Community`
const pageDescription = !name
  ? undefined
  : scheduleYear
    ? `${name} on the Jingle Jam Community site: Jingle Jam ${scheduleYear} stream schedule, upcoming streams, Tiltify fundraiser and social links.`
    : `${name} on the Jingle Jam Community site: Tiltify fundraiser, social links, friends and teams for the Jingle Jam.`

// Avatar border in the server-rendered header: only a hex colour goes into the style attribute
const userAccentColor = user?.style.accentColor ?? ''
const accentColor = /^#[0-9a-f]{3,8}$/i.test(userAccentColor)
  ? userAccentColor
  : '#3584BF'
---

<PageShell title={pageTitle} description={pageDescription} robots="noindex,follow">
  {error && (
    <Alert tone="danger" title="This profile couldn't be loaded">
      Please try again in a moment.
    </Alert>
  )}

  {
    !error && user && (
      <div class="flex flex-col gap-3">
        <Tile class="flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-4">
          {/* A border (not a ring) in the user's accent colour */}
          <div
            class="shadow-tile size-24 shrink-0 overflow-hidden rounded-full border-4"
            style={`border-color: ${accentColor}`}
          >
            <img
              src={user.user.profileImage}
              alt={`${user.user.username}'s profile`}
              class="size-full object-cover"
            />
          </div>
          <div class="flex min-w-0 flex-1 flex-col gap-2">
            <h1 class="truncate text-2xl font-bold tracking-tight sm:text-3xl">
              {user.user.username}
            </h1>
            <UserHeaderLinks client:only="solid-js" user={user} />
          </div>
        </Tile>
        {user.primarySchedule && user.nextPrimaryStreams.length > 0 && (
          <NextStreamsSection
            client:only="solid-js"
            primarySchedule={user.primarySchedule}
            streams={user.nextPrimaryStreams}
            user={user.user}
          />
        )}
        {user.friends.length > 0 && (
          <FriendsSection client:only="solid-js" friends={user.friends} />
        )}
        {user.teams.length > 0 && <UserTeamsSection teams={user.teams} />}
        {user.schedules.length > 0 && (
          <OtherSchedulesSection schedules={user.schedules} />
        )}
        {user.related.length > 0 && (
          <RelatedSection client:only="solid-js" related={user.related} />
        )}
      </div>
    )
  }
</PageShell>
