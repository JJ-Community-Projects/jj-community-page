---
import {actions} from 'astro:actions';
import BaseLayout from "../../layouts/BaseLayout.astro";
import UserHeader from "../../components/features/users/public/UserHeader.astro";
import UserSchedule from "../../components/features/users/public/UserSchedule.astro";
import UserTeams from "../../components/features/users/public/UserTeams.astro";
import {ActiveSchedule} from "../../components/features/users/public/schedule/ActiveSchedule";

const {username} = Astro.params;

if (!username) {
  return Astro.redirect('/user-not-found')
}
const {data: user, error} = await Astro.callAction(actions.ui.users.bySlug, username)

if (error) {
  return Astro.redirect(`/${username}/error`)
}

if (user === undefined) {
    throw Astro.redirect('/user-not-found')
}



// Fetch the user's primary schedule for the ActiveSchedule component
// const { data: primarySchedule, error: scheduleError } = await Astro.callAction(actions.ui.users.schedules.getCurrentPrimaryByTiltifyUsername, username);
---
<BaseLayout title={`${user.name} | Jingle Jam Community`}>
    <div class="w-full max-w-4xl mx-auto">
        <UserHeader user={user}/>

      {/* Display ActiveSchedule if primary schedule is available */}
      {user.schedule && (
              <div class="w-full bg-white rounded-lg p-6 mb-4 shadow-md">
                  <ActiveSchedule client:load initSchedule={user.schedule}/>
              </div>
      )}

        <UserSchedule tiltifyUsername={username}/>
        <UserTeams tiltifyUsername={username} userId={user.id}/>
    </div>
</BaseLayout>
