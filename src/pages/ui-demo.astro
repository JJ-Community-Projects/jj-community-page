---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CardDemo } from "../components/demo/CardDemo";
import { CountdownDemo } from "../components/demo/CountdownDemo";
import { LivePulseDotDemo } from "../components/demo/LivePulseDotDemo";
import { ConfirmationDialogDemo } from "../components/demo/ConfirmationDialogDemo";
import { StreamPlaceholderDemo } from "../components/demo/StreamPlaceholderDemo";
import { PillComponentDemo } from "../components/ui/PillComponentDemo";
---

<BaseLayout title="UI Component Demo">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8 text-center">JingleJam UI Component Library</h1>

    <p class="text-lg text-center mb-12 max-w-3xl mx-auto">
      This page showcases the various UI components used throughout the JingleJam Community Page.
      Each component is displayed with examples and descriptions to help understand its usage and features.
    </p>

    <div class="space-y-12">
      <!-- Table of Contents -->
      <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 shadow-lg">
        <h2 class="text-2xl font-bold mb-4">Table of Contents</h2>
        <ul class="space-y-2">
          <li><a href="#pills" class="text-accent hover:underline">Pill Components</a></li>
          <li><a href="#cards" class="text-accent hover:underline">Card Components</a></li>
          <li><a href="#countdown" class="text-accent hover:underline">Countdown Component</a></li>
          <li><a href="#live-pulse" class="text-accent hover:underline">Live Pulse Dot Component</a></li>
          <li><a href="#confirmation-dialog" class="text-accent hover:underline">Confirmation Dialog Component</a></li>
          <li><a href="#stream-placeholder" class="text-accent hover:underline">Stream Placeholder Component</a></li>
        </ul>
      </div>

      <!-- Pill Components -->
      <section id="pills" class="bg-white/10 backdrop-blur-sm rounded-xl p-6 shadow-lg">
        <PillComponentDemo client:load />
      </section>

      <!-- Card Components -->
      <section id="cards" class="bg-white/10 backdrop-blur-sm rounded-xl p-6 shadow-lg">
        <CardDemo client:load />
      </section>

      <!-- Countdown Component -->
      <section id="countdown" class="bg-white/10 backdrop-blur-sm rounded-xl p-6 shadow-lg">
        <CountdownDemo client:load />
      </section>

      <!-- Live Pulse Dot Component -->
      <section id="live-pulse" class="bg-white/10 backdrop-blur-sm rounded-xl p-6 shadow-lg">
        <LivePulseDotDemo client:load />
      </section>

      <!-- Confirmation Dialog Component -->
      <section id="confirmation-dialog" class="bg-white/10 backdrop-blur-sm rounded-xl p-6 shadow-lg">
        <ConfirmationDialogDemo client:load />
      </section>

      <!-- Stream Placeholder Component -->
      <section id="stream-placeholder" class="bg-white/10 backdrop-blur-sm rounded-xl p-6 shadow-lg">
        <StreamPlaceholderDemo client:load />
      </section>
    </div>

    <div class="mt-12 text-center">
      <p class="text-sm text-gray-300">
        This demo page was created to showcase the UI components used in the JingleJam Community Page.
        For more information, check out the project repository.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  /* Add any global styles specific to the demo page here */
  section {
    scroll-margin-top: 2rem;
  }
</style>
