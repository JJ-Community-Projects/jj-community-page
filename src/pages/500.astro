---
import BaseLayout4xl from '../layouts/BaseLayout4xl.astro'

// Astro renders this for any error thrown while rendering. Without it, the catch-all
// `[...username]` would match `/500` and answer with the 404 page.
export const prerender = false
---

<BaseLayout4xl
  title="Something went wrong | Jingle Jam Community"
  description="An error occurred on the Jingle Jam Community site."
>
  <div class="flex w-full flex-col items-center gap-4 rounded-xl border border-white/10 bg-white/5 p-6 text-center text-white">
    <h1 class="fl-text-2xl/4xl">Something went wrong</h1>
    <p class="text-white/90">
      This page couldn't be loaded. Please try again in a moment.
    </p>
    <a href="/" class="underline hover:text-accent">Back to the homepage</a>
  </div>
</BaseLayout4xl>
