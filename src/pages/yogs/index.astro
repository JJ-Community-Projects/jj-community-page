---
export const prerender = false
import { getYogsScheduleFromContent } from '../../content/getYogsScheduleFromContent.ts'
import YogsTVExtBanner from '../../components/yogs-pages/common/YogsTVExtBanner.astro'
import { YogsCurrentScheduleLoader } from '../../components/yogs-pages/schedule/YogsCurrentScheduleLoader.tsx'

import BaseLayout from '../../layouts/BaseLayout.astro'
import { YogsCreatorPill } from '../../components/yogs-pages/creators/YogsCreatorPill.tsx'
import { InstagramIcon, TiktokIcon, TwitchIcon, TwitterIcon, YoutubeIcon } from '../../components/yogs-pages/common/YogsJJIcons.tsx'

const fallbackSchedule = await getYogsScheduleFromContent(2023)
const currentSchedule = await getYogsScheduleFromContent(2025)
const creators = currentSchedule.creators

const yogs = creators.filter(
  (creator) => creator.type === 'yogs' || creator.type === 'staff',
)
const bestOf = creators.filter((creator) => creator.type === 'best_of')
const friends = creators.filter((creator) => creator.type === 'friend')

const filter = Astro.url.searchParams.get('filter') || ''
console.log(filter)
const filterCreators = () => {
  if (filter === '') {
    return null
  }
  const ids = filter.split(',')
  return creators.filter((creator) => ids.includes(creator.id))
}

const filteredCreators = filterCreators()

let description =
  'Yogscast Jingle Jam 2025 Interactive Schedule with additional information made by the Community.'

if (filteredCreators) {
  if (filteredCreators.length === 1) {
    description = `The Yogscast Jingle Jam 2025 Schedule for ${filteredCreators[0].name}`
  } else if (filteredCreators.length <= 3) {
    let nameStr = ''
    const filteredCreatorsLastIndex = filteredCreators.length - 1
    for (let i = 0; i < filteredCreators.length; i++) {
      nameStr += filteredCreators[i].name
      if (i < filteredCreatorsLastIndex - 1) {
        nameStr += ', '
      } else if (i === filteredCreatorsLastIndex - 1) {
        nameStr += ' and '
      }
    }
    description = `The Yogscast Jingle Jam 2025 Schedule for ${nameStr}`
  } else {
    let nameStr = ''
    for (let i = 0; i < 3; i++) {
      nameStr += filteredCreators[i].name
      if (i < 2) {
        nameStr += ', '
      } else {
        nameStr += ' and more'
      }
    }
    description = `The Yogscast Jingle Jam 2025 Schedule for ${nameStr}`
  }
}
---

<style is:global>
  :root {
    --jj-schedule-available-height: max(85vh, 400px);
    --jj-schedule-available-width: min(max(85vw, 600px), 1600px);
    --jj-schedule-w-size: calc(
      var(--jj-schedule-available-width) / (7 * 3 + 1)
    );
    --jj-schedule-h-size: calc(
      var(--jj-schedule-available-height) / (5 * 3 + 2)
    );
    --jj-schedule-data-size: max(
      var(--jj-schedule-w-size),
      var(--jj-schedule-h-size)
    );
    --jj-schedule-slot-size: calc(var(--jj-schedule-data-size) * 3);

    /* Placeholder-prefixed variables mirroring the schedule sizing */
    --placeholder-jj-schedule-available-height: 400px;
    --placeholder-jj-schedule-available-width: 400px;
    --placeholder-jj-schedule-w-size: calc(
      var(--placeholder-jj-schedule-available-width) / (7 * 3 + 1)
    );
    --placeholder-jj-schedule-h-size: calc(
      var(--placeholder-jj-schedule-available-height) / (5 * 3 + 2)
    );
    --placeholder-jj-schedule-data-size: max(
      var(--placeholder-jj-schedule-w-size),
      var(--placeholder-jj-schedule-h-size)
    );
    --placeholder-jj-schedule-slot-size: calc(var(--placeholder-jj-schedule-data-size) * 3);
  }

  /* Scope overrides: inside .jj-placeholder use the placeholder-* values */
  .jj-placeholder {
    --jj-schedule-available-height: var(--placeholder-jj-schedule-available-height);
    --jj-schedule-available-width: var(--placeholder-jj-schedule-available-width);
    --jj-schedule-w-size: var(--placeholder-jj-schedule-w-size);
    --jj-schedule-h-size: var(--placeholder-jj-schedule-h-size);
    --jj-schedule-data-size: var(--placeholder-jj-schedule-data-size);
    --jj-schedule-slot-size: var(--placeholder-jj-schedule-slot-size);
  }

  .timezone {
    width: var(--jj-schedule-data-size);
    height: var(--jj-schedule-data-size);
  }

  .timezone-text {
    font-size: 0.5rem;
    line-height: 0.75rem;
  }

  .schedule-container {
    width: 80vw;
    min-height: 100%;
  }

  .schedule-body {
    width: 100%;
    height: 100%;
  }

  .schedule {
    width: var(--jj-schedule-available-width);
    height: 100%;
  }

  .time {
    width: var(--jj-schedule-data-size);
    height: var(--jj-schedule-slot-size);
  }

  .data-height {
    height: var(--jj-schedule-data-size);
  }

  .data-width {
    width: var(--jj-schedule-data-size);
  }

  .stream-width {
    width: var(--jj-schedule-slot-size);
  }

  .stream-height {
    height: var(--jj-schedule-slot-size);
  }

  .day {
    width: 100%;
    height: var(--jj-schedule-data-size);
  }

  .day-container {
    width: var(--jj-schedule-slot-size);
    height: 100%;
  }

  .header-title-card-width {
    width: calc(var(--jj-schedule-slot-size) * 3);
  }

  @media (max-width: 900px) {
    .desktop-schedule {
      display: none;
    }
  }

  @media (min-width: 901px) {
    .mobile-schedule {
      display: none;
    }
  }
</style>
<BaseLayout
  title="The Yogscast Jingle Jam 2025 Schedule"
  description={description}
  canonical="https://jinglejam.ostof.dev/yogs"
>
  <YogsTVExtBanner />

  <div class={'min-h-32'}>
    <YogsCurrentScheduleLoader
      client:only="solid-js"
      creators={creators}
      fallbackSchedule={fallbackSchedule!}
    />
  </div>

{creators.length > 0 && (  <div class="flex flex-col justify-center items-center p-4 gap-2">
    <p class="text-2xl text-white text-center">Yogs & Friends</p>
    <div class="flex flex-col items-center gap-2">
      {
        yogs.length > 0 && (
          <p class="text-xl text-white mb-1">Yogs</p>
          <div class="flex flex-wrap gap-2 items-center justify-center">
            {
              yogs &&
              yogs.map((creator) => (
                <YogsCreatorPill creator={creator} client:only="solid-js" />
              ))
            }
          </div>
        )
      }
      {
        bestOf.length > 0 && (
          <p class="text-xl text-white mb-1">Best Of</p>
          <div class="flex flex-wrap gap-2 items-center justify-center">
            {bestOf &&
              bestOf.map((creator) => (
                <YogsCreatorPill creator={creator} client:only="solid-js" />
              ))}
          </div>
        )
      }
      {
        friends.length > 0 && (
            <p class="text-xl text-white mb-1">Friends</p>
            <div class="flex flex-wrap gap-2 items-center justify-center">
              {friends &&
                friends.map((creator) => (
                  <YogsCreatorPill creator={creator} client:only="solid-js" />
                ))}
            </div>
        )
      }
    </div>
  </div>
  )}

</BaseLayout>
