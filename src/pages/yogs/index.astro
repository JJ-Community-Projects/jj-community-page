---
import YogsBanner from '../../components/yogs-pages/common/YogsBanner.astro'
export const prerender = false
import PageShell from '../../layouts/PageShell.astro'
import { getYogsScheduleFromContent } from '../../content/getYogsScheduleFromContent.ts'
import {
  serverClientPrivate,
  serverClientPublic,
} from '../../lib/orpc/serverClient'
import { getCollection } from 'astro:content'
import { YogsResponsiveSchedule } from '../../components/yogs-pages/schedule/YogsResponsiveSchedule.tsx'
import { YogsSeasonSchedule } from '../../components/yogs-pages/schedule/YogsSeasonSchedule.tsx'
import { ScheduleNotice } from '../../components/yogs-pages/schedule/YogsCurrentScheduleLoader.tsx'
import { JJStartCountdown, JJStartTimes } from '../../components/ui/Countdown'
import { PageHeader } from '../../components/ui/PageHeader'
import { Tile } from '../../components/ui/Tile'
import { Button } from '../../components/ui/Button'
import { compactYogsSchedule } from '../../lib/utils/compactYogsSchedule.ts'
import {
  getBreadcrumbList,
  getJingleJamEventSeries,
} from '../../content/getJingleJamEventSeries.ts'
import type { YogsSchedule } from '../../lib/orpc/private/yogs/contract.ts'
import { canonicalUrl, SITE_URL } from '../../lib/utils/canonical.ts'
import { getConfigYear } from '../../lib/utils/configYear.ts'
import { upcomingJJYear } from '../../lib/utils/jjYear.ts'

const context = {
  context: {
    locals: Astro.locals,
    request: Astro.request,
  },
}

const { data: contentHidden } =
  await serverClientPublic.overlays.visibility.getHidden({}, context)
const HIDE_CONTENT = contentHidden ?? true

const year = await getConfigYear()

// Years with a visible schedule in the content collection, newest first
const contentYears = (await getCollection('schedules'))
  .filter((schedule) => schedule.data.visible && /^\d{4}$/.test(schedule.id))
  .map((schedule) => Number(schedule.id))
  .sort((a, b) => b - a)

// The new schedule is shown once content is visible and the configured year has a schedule.
// Until then /yogs is a hub with the countdown and last year's schedule (no redirect).
const scheduleAvailable = !HIDE_CONTENT && contentYears.includes(year)

const upcomingYear = upcomingJJYear(year, !scheduleAvailable)
const archiveYears = contentYears.filter((y) => y < upcomingYear)
const lastYear = scheduleAvailable ? undefined : archiveYears.at(0)

// In season the schedule is server-rendered from the source the API serves (KV, falling back to
// the content collection); `web:config.showSchedule` can still hold it back.
let showSchedule = true
let currentSchedule: YogsSchedule | undefined
if (scheduleAvailable) {
  const [config, live] = await Promise.all([
    serverClientPrivate.yogs.config({}, context),
    serverClientPrivate.yogs.schedule({}, context),
  ])
  showSchedule = config.data?.showSchedule ?? true
  currentSchedule = live.data ?? (await getYogsScheduleFromContent(year))
}
const lastSchedule = lastYear
  ? await getYogsScheduleFromContent(lastYear)
  : undefined
const creators = (currentSchedule ?? lastSchedule)?.creators ?? []
const scheduleYear = scheduleAvailable ? year : (lastYear ?? year)

const filter = Astro.url.searchParams.get('filter') || ''

const filterCreators = () => {
  if (filter === '') {
    return null
  }
  const ids = filter.split(',').sort((a, b) => a.localeCompare(b))
  return creators.filter((creator) => ids.includes(creator.id))
}

const filteredCreators = filterCreators()

const joinNamesGrammatically = (names: string[], max = names.length) => {
  const slice = names.slice(0, max)
  if (slice.length === 1) return slice[0]
  if (slice.length === 2) return `${slice[0]} and ${slice[1]}`
  if (names.length <= max) {
    const s1 = slice.slice(0, slice.length - 1).join(', ')
    const s2 = ` and ${slice[slice.length - 1]}`
    return s1 + s2
  }
  return slice.join(', ') + ' and more'
}

// Base values
const baseTitle = `Yogscast Jingle Jam ${year} Schedule & Timetable`
const baseDescription = `Yogscast Jingle Jam ${year} schedule and timetable in your timezone: every stream with participants, VODs and more - maintained by the community.`

// Build dynamic title/description when filtered
let title = baseTitle
let description = baseDescription

if (filteredCreators && filteredCreators.length > 0) {
  const names = filteredCreators.map((c) => c.name)
  if (names.length === 1) {
    title = `Yogscast Jingle Jam ${year} Schedule - ${names[0]}`
    description = `Schedule for ${names[0]} - Yogscast Jingle Jam ${year} schedule with streams, participants, and VODs - maintained by the community.`
  } else if (names.length <= 4) {
    const list = joinNamesGrammatically(names)
    title = `Yogscast Jingle Jam ${year} Schedule - ${list}`
    description = `Schedule with ${list} - Yogscast Jingle Jam ${year} schedule with streams, participants, and VODs - maintained by the community.`
  } else {
    const list = joinNamesGrammatically(names, 4)
    title = `Yogscast Jingle Jam ${year} Schedule - ${list}`
    description = `Schedule with ${list} - Yogscast Jingle Jam ${year} schedule with streams, participants, and VODs - maintained by the community.`
  }
}

// Hub until the new schedule is announced: title/description target the upcoming year
if (!scheduleAvailable) {
  title = `Yogscast Jingle Jam ${upcomingYear} Schedule & Timetable`
  description = lastYear
    ? `Yogscast Jingle Jam ${upcomingYear} schedule: countdown to the start and the ${lastYear} schedule until the new one is announced - maintained by the community.`
    : `Yogscast Jingle Jam ${upcomingYear} schedule: countdown to the start until the new schedule is announced - maintained by the community.`
  if (filteredCreators && filteredCreators.length > 0) {
    const names = filteredCreators.map((c) => c.name)
    title = `Yogscast Jingle Jam ${upcomingYear} Schedule - ${joinNamesGrammatically(names, 4)}`
  }
}

// Keep description roughly ≤160 chars for SERP
const trim = (s: string, max = 160) =>
  s.length > max ? s.slice(0, max - 1) + '…' : s
description = trim(description)

// Canonical/noindex policy for filtered pages
const hasFilter = Boolean(filter)
const robots = hasFilter ? 'noindex,follow' : 'index,follow'

const canonical = canonicalUrl('/yogs')
// EventSeries only while this page shows the current schedule; the hub has no data for it
const jsonLd = [
  currentSchedule && showSchedule
    ? getJingleJamEventSeries(currentSchedule, canonical)
    : undefined,
  getBreadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Yogscast Jingle Jam Schedule', url: canonical },
  ]),
]

function buildFilters() {
  const ids = creators.map((c) => c.id)
  const out = new Set<string>()
  // one
  for (const a of ids) out.add(a)

  out.add('lewis,simon')
  out.add('lewis,spiff')
  out.add('lewis,lydia')
  out.add('tom,lydia')
  out.add('lewis,tom')
  out.add('ben,tom')
  out.add('ben,mousie')
  out.add('ravs,sips')
  out.add('bouphe,osie')
  out.add('duncan,osie')
  out.add('boba,pedguin')
  out.add('briony,kirsty')
  out.add('lewis,harry,simon,duncan')
  out.add('nilesy,breeh,zylus')
  out.add('nilesy,breeh,zylus,rythian')
  out.add('nilesy,breeh,zylus,rythian,ravs')
  out.add('tom,pyrion')
  return Array.from(out).map((s) =>
    s
      .split(',')
      .sort((a, b) => a.localeCompare(b))
      .join(','),
  )
}

const preRenderdFilters = buildFilters()

const sortedFilter =
  filteredCreators
    ?.map((creator) => creator.id)
    .sort((a, b) => a.localeCompare(b))
    .join(',') ?? ''

const preRenderedImgName = `${sortedFilter.replaceAll(',', '-')}.png`

const hasPreRenderdImage = preRenderdFilters.includes(sortedFilter)

const preRenderdImageExists =
  (filteredCreators !== null && filteredCreators.length === 1) ||
  hasPreRenderdImage

const notFilterImage = `${SITE_URL}/jj-og-yogs.png`
const filterImage = `${SITE_URL}/api/public/img/yogs-schedule-preview?filter=${filter}&year=${scheduleYear}`
const preRenderedFilterImage = `${SITE_URL}/yogs-schedule-preview/${preRenderedImgName}`

const ogImage = preRenderdImageExists
  ? preRenderedFilterImage
  : hasFilter
    ? filterImage
    : notFilterImage

---

<style is:global>
  :root {
    --jj-schedule-available-height: max(80vh, 400px);
    --jj-schedule-available-width: min(max(80vw, 600px), 1600px);
    --jj-schedule-w-size: calc(
      var(--jj-schedule-available-width) / (7 * 3 + 1)
    );
    --jj-schedule-h-size: calc(
      var(--jj-schedule-available-height) / (5 * 3 + 2)
    );
    --jj-schedule-data-size: max(
      var(--jj-schedule-w-size),
      var(--jj-schedule-h-size)
    );
    --jj-schedule-slot-size: calc(var(--jj-schedule-data-size) * 3);

    /* Placeholder-prefixed variables mirroring the schedule sizing */
    --placeholder-jj-schedule-available-height: 400px;
    --placeholder-jj-schedule-available-width: 400px;
    --placeholder-jj-schedule-w-size: calc(
      var(--placeholder-jj-schedule-available-width) / (7 * 3 + 1)
    );
    --placeholder-jj-schedule-h-size: calc(
      var(--placeholder-jj-schedule-available-height) / (5 * 3 + 2)
    );
    --placeholder-jj-schedule-data-size: max(
      var(--placeholder-jj-schedule-w-size),
      var(--placeholder-jj-schedule-h-size)
    );
    --placeholder-jj-schedule-slot-size: calc(
      var(--placeholder-jj-schedule-data-size) * 3
    );
  }

  /* Scope overrides: inside .jj-placeholder use the placeholder-* values */
  .jj-placeholder {
    --jj-schedule-available-height: var(
      --placeholder-jj-schedule-available-height
    );
    --jj-schedule-available-width: var(
      --placeholder-jj-schedule-available-width
    );
    --jj-schedule-w-size: var(--placeholder-jj-schedule-w-size);
    --jj-schedule-h-size: var(--placeholder-jj-schedule-h-size);
    --jj-schedule-data-size: var(--placeholder-jj-schedule-data-size);
    --jj-schedule-slot-size: var(--placeholder-jj-schedule-slot-size);
  }

  .timezone {
    width: var(--jj-schedule-data-size);
    height: var(--jj-schedule-data-size);
  }

  .timezone-text {
    font-size: 0.5rem;
    line-height: 0.75rem;
  }

  .schedule-container {
    width: 80vw;
    min-height: 100%;
  }

  .schedule-body {
    width: 100%;
    height: 100%;
  }

  .schedule {
    width: var(--jj-schedule-available-width);
    height: 100%;
  }

  .time {
    width: var(--jj-schedule-data-size);
    height: var(--jj-schedule-slot-size);
  }

  .data-height {
    height: var(--jj-schedule-data-size);
  }

  .data-width {
    width: var(--jj-schedule-data-size);
  }

  .stream-width {
    width: var(--jj-schedule-slot-size);
  }

  .stream-height {
    height: var(--jj-schedule-slot-size);
  }

  .day {
    width: 100%;
    height: var(--jj-schedule-data-size);
  }

  .day-container {
    width: var(--jj-schedule-slot-size);
    height: 100%;
  }

  .header-title-card-width {
    width: calc(var(--jj-schedule-slot-size) * 3);
  }

  @media (max-width: 900px) {
    .desktop-schedule {
      display: none;
    }
  }

  @media (min-width: 901px) {
    .mobile-schedule {
      display: none;
    }
  }
</style>
<PageShell width="full"
  title={title}
  description={description}
  robots={robots}
  canonical={canonical}
  og={{
    image: ogImage,
  }}
  jsonLd={jsonLd}
>
  <YogsBanner/>

  {scheduleAvailable ? (
    <div class="flex w-full flex-col items-center gap-4">
      <PageHeader
        title={`Yogscast Jingle Jam ${year} Schedule`}
        subtitle={`The Yogscast Jingle Jam ${year} in your timezone with links to participants, VODs and more.`}
      />

      {showSchedule && currentSchedule ? (
        <div class="min-h-32 w-full">
          <YogsSeasonSchedule
            schedule={compactYogsSchedule(currentSchedule)}
            client:load
          />
        </div>
      ) : (
        <Tile class="flex w-full max-w-2xl flex-col items-center gap-3 text-center">
          <JJStartCountdown client:only="solid-js" />
          <JJStartTimes client:only="solid-js" />
          <p class="text-sm sm:text-base">
            The <span class="font-bold">Yogscast Jingle Jam {year} Schedule</span>
            will be shown once it is announced on social media.
          </p>
          <ScheduleNotice />
        </Tile>
      )}
    </div>
  ) : (
    <div class="flex w-full flex-col items-center gap-4">
      <PageHeader
        title={`Yogscast Jingle Jam ${upcomingYear} Schedule`}
        subtitle="The Yogscast Jingle Jam in your timezone with links to participants, VODs and more."
      />
      <Tile class="flex w-full max-w-2xl flex-col items-center gap-3 text-center">
        <JJStartCountdown client:only="solid-js" />
        <JJStartTimes client:only="solid-js" />
        <p class="text-sm sm:text-base">
          The <span class="font-bold">Yogscast Jingle Jam {upcomingYear} Schedule</span>
          will appear here once it is announced.
          {lastYear && ` Until then you can browse the ${lastYear} schedule below.`}
        </p>
      </Tile>

      {lastSchedule && (
        <section class="flex w-full flex-col items-center gap-2">
          <h2 class="text-on-canvas text-center text-xl font-bold">
            Jingle Jam {lastYear} Schedule
          </h2>
          <p class="text-on-canvas-muted text-center text-sm">
            Last year's Yogscast Jingle Jam schedule with links to participants
            and VODs.
          </p>

          <YogsResponsiveSchedule
            schedule={compactYogsSchedule(lastSchedule)}
            showCreators
            client:load
          >
            <p class="text-on-canvas-muted mx-auto mt-4 max-w-3xl text-center text-sm">
              This Yogscast Jingle Jam schedule is maintained by the community. If
              you find errors or see that a stream is missing use the contact info
              below. Streams that appear here are not guaranteed to happen or might
              be delayed. For more information visit the Jingle Jam Twitter page.
              This schedule is a fan Project and not associated with the Jingle
              Jam, the Yogscast or their partners.
            </p>
          </YogsResponsiveSchedule>
        </section>
      )}

      {archiveYears.length > 0 && (
        <nav
          aria-label="Yogscast Jingle Jam schedule archive"
          class="flex flex-col items-center gap-2 p-4"
        >
          <h2 class="text-on-canvas text-center text-lg font-semibold">Schedule archive</h2>
          <div class="flex flex-wrap items-center justify-center gap-2">
            {archiveYears.map((archiveYear) => (
              <Button href={`/yogs/archive/${archiveYear}`} size="sm" variant="canvas">
                Jingle Jam {archiveYear}
              </Button>
            ))}
          </div>
        </nav>
      )}
    </div>
  )}
</PageShell>
