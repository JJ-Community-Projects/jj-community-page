---
import PageShell from '../../layouts/PageShell.astro'
import {loadAllCreatorsFromContent} from "../../content/loadCreatorsFromContent";
import {type FullCreator} from "../../lib/model/ContentTypes";
import {StatsPageRoot} from "../../components/yogs-pages/stats/StatsPage";
import { PageHeader } from '../../components/ui/PageHeader'
import {getBreadcrumbList} from "../../content/getJingleJamEventSeries";
const creators = await loadAllCreatorsFromContent();
const creatorMap: { [key: string]: FullCreator } = {}
for (const creator of creators) {
  creatorMap[creator.id] = creator
}

// Years with a stats file (src/stats/<year>.json), for the intro text
const statsYears = Object.keys(import.meta.glob('../../stats/*.json'))
  .map((file) => Number(file.match(/(\d{4})\.json$/)?.[1]))
  .filter((year) => !Number.isNaN(year))
  .sort((a, b) => a - b)
const yearRange = statsYears.length > 0 ? `${statsYears[0]} to ${statsYears.at(-1)}` : ''

const jsonLd = [
  getBreadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Yogscast Jingle Jam Schedule', url: '/yogs' },
    { name: 'Statistics', url: '/yogs/stats' },
  ]),
]
---
<PageShell
  width="wide"
  title="Yogscast Jingle Jam Statistics: Streams, Creators & Donations"
  description={`Statistics for every Yogscast Jingle Jam${yearRange && ` from ${yearRange}`}: donations per stream and per hour, and how often each creator appeared - maintained by the community.`}
  jsonLd={jsonLd}
>
  <div class="flex flex-col gap-3">
    <PageHeader
      title="Yogscast Jingle Jam Statistics"
      subtitle={`Stream and donation statistics for the Yogscast Jingle Jam${yearRange && ` from ${yearRange}`}: what each stream and each hour raised, and how often and how long each creator appeared. Pick a year to see its charts.`}
      back={{ href: '/yogs', label: 'Yogscast schedule' }}
    />
    <StatsPageRoot client:only="solid-js" creatorMap={creatorMap}>
      <div slot="fallback" class="text-on-canvas-muted text-center text-sm">Loading…</div>
    </StatsPageRoot>
  </div>
</PageShell>
