---
import ErrorPage from '../layouts/ErrorPage.astro'
import { Button } from '../components/ui/Button'

// Get the error message from the URL query parameter
const { searchParams } = new URL(Astro.request.url);
const errorMessage = searchParams.get('error') || 'default';

// Map error codes to user-friendly messages
const errorMessages = new Map([
  ['missing-code', 'Authentication code is missing. Please try again.'],
  ['missing-state', 'Authentication state is missing. Please try again.'],
  ['state-mismatch', 'Authentication state is not matching. Please try again.'],
  ['token-exchange-failed', 'Failed to exchange authentication token. Please try again.'],
  ['user-fetch-failed', 'Failed to fetch user information. Please try again.'],
  ['default', 'An authentication error occurred. Please try again.']
]);

// Get the appropriate error message
const displayMessage = errorMessages.get(errorMessage) || errorMessages.get('default')
---


<ErrorPage title="Authentication Error" heading="Authentication error">
  {displayMessage}
  <Fragment slot="actions">
    <Button href="/login" size="sm" variant="primary">Try again</Button>
    <Button href="/" size="sm">Go home</Button>
  </Fragment>
</ErrorPage>
