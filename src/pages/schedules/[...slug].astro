---
import {serverClientPublic} from "../../lib/orpc/client";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {UserSchedulePage} from "../../components/features/schedules/UserSchedulePage";
import {DebugJSONView} from "../../components/common/DebugJSONView";

const {slug} = Astro.params

if (!slug) {
  return Astro.redirect('/error')
}

const {data: schedule, error} = await serverClientPublic.schedules.getFullScheduleBySlug({slug}, {
  context: {
    locals: Astro.locals,
    request: Astro.request,
  }
})

if (error) {
  console.error(error)
}
---
<BaseLayout title={schedule?.data.title || "Schedule"}>
  {
    error && (
                  <div class="container mx-auto px-4 py-8">
                      <div class="bg-white p-6 rounded-lg shadow-lg">
                          <h1 class="text-2xl font-bold text-red-600 mb-4">Error</h1>
                          <p class="text-gray-800">{error.message}</p>
                      </div>
                  </div>
    )
  }
  {
    (!error && schedule) && (
                  <div class="container mx-auto px-4 py-8">
                      <UserSchedulePage client:only="solid-js" initSchedule={schedule}/>
                      <DebugJSONView client:only="solid-js" data={schedule} title="DEBUG Schedule Data"/>
                  </div>
    )
  }
</BaseLayout>
