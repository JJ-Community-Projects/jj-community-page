---
import { serverClientPublic } from '../../lib/orpc/serverClient'
import PageShell from '../../layouts/PageShell.astro'
import {
  NextStreamsIsland,
  FullScheduleIsland,
} from '../../components/features/schedules/UserSchedulePage'
import { DebugJSONView } from '../../components/common/DebugJSONView'
import { PageHeader } from '../../components/ui/PageHeader'
import { Alert } from '../../components/ui/Status'
import { Section } from '../../components/ui/Tile'
import { isNotFoundError } from '../../lib/utils/notFound'

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect('/error')
}

const { data: schedule, error } =
  await serverClientPublic.schedules.getFullScheduleBySlug(
    { slug },
    {
      context: {
        locals: Astro.locals,
        request: Astro.request,
      },
    }
  )

// Unknown or hidden schedule: a real 404, not a 200 with the error card.
if (isNotFoundError(error)) {
  return Astro.rewrite('/404')
}

if (error) {
  Astro.response.status = 500
  console.error(error)
}

const isDebug = Astro.url.searchParams.get('debug') === '1'
const pageTitleBase = schedule?.data?.title ?? 'Schedule'

const ownerName = schedule?.owner?.username ?? ''
const ownerSlug = schedule?.owner?.tiltifySlug ?? ''

// Title and description from the schedule and its owner
const pageTitle = ownerName
  ? `${pageTitleBase} by ${ownerName} | Jingle Jam Community`
  : `${pageTitleBase} | Jingle Jam Community`
const streamCount = schedule?.streams.length ?? 0
const pageDescription = schedule
  ? `${ownerName ? `${ownerName}'s ` : ''}Jingle Jam ${schedule.data.year} stream schedule "${pageTitleBase}": ${streamCount} ${streamCount === 1 ? 'stream' : 'streams'} with times in your timezone and the next streams coming up.`
  : undefined
---

<PageShell title={pageTitle} description={pageDescription} robots="noindex,follow">
  <div class="flex flex-col gap-3">
    <PageHeader title={pageTitleBase}>
      {ownerName && (
        <span slot="subtitle">
          by <a href={`/${ownerSlug}`} class="text-on-canvas font-semibold underline">{ownerName}</a>
          {schedule && ` · Jingle Jam ${schedule.data.year}`}
        </span>
      )}
    </PageHeader>

    {error && (
      <Alert tone="danger" title="This schedule couldn't be loaded">
        {error.message}
      </Alert>
    )}

    {!error && schedule && (
      <NextStreamsIsland client:only="solid-js" initSchedule={schedule} />
    )}

    {!error && schedule && (
      <FullScheduleIsland client:only="solid-js" initSchedule={schedule} />
    )}

    {!error && schedule && isDebug && (
      <Section title="Debug Data">
        <DebugJSONView client:only="solid-js" data={schedule} title="DEBUG Schedule Data" />
      </Section>
    )}
  </div>
</PageShell>
