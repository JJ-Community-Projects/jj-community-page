---
import BaseLayout from "../layouts/BaseLayout.astro";
import {actions} from "astro:actions";
import {ScheduleDayHorizontal} from "../components/features/schedules/common/ScheduleDayHorizontal";
import {ScheduleDayVertical} from "../components/features/schedules/common/ScheduleDayVertical";
import {ScheduleStreamCard} from "../components/features/schedules/common/StreamCard";
import {fullJJExampleSchedule} from "../functions/exampleSchedule";
import {WeekScheduleDesktopComponent} from "../components/features/schedules/desktop/WeekScheduleDesktopComponent";
const {data, error} = await Astro.callAction(actions.ui.users.schedules.demo, {})
// const data = await fullJJExampleSchedule()
const size = Buffer.byteLength(JSON.stringify(data))
const kiloBytes = size / 1024;
const megaBytes = kiloBytes / 1024;
---
<BaseLayout>
    <p>Size: {size}</p>
    <p>kiloBytes: {kiloBytes}</p>
    <p>megaBytes: {megaBytes}</p>
    <h1 class="text-3xl font-bold mb-6">Schedule UI Components Demo</h1>
  {
    (error) && (
                  <p>{error.message}</p>
    )
  }

  {
    (data) && (
                  <div class="flex flex-col gap-8">
                      <section>
                          <h2 class="text-2xl font-bold mb-4">Schedule Stream Card Variants</h2>

                          <div class="flex flex-col gap-8">
                              <div>
                                  <h3 class="text-xl font-bold mb-2">Filled Schedule Stream Card</h3>
                                  <div class="flex flex-wrap gap-2">
                                    {data.streams!.slice(0, 3).map((stream) => (
                                            <div class="w-64">
                                                <ScheduleStreamCard stream={stream} type="filled" hover={false}
                                                                    client:only="solid-js"/>
                                            </div>
                                    ))}
                                  </div>
                              </div>

                              <div>
                                  <h3 class="text-xl font-bold mb-2">Schedule Stream Card with Left Bar</h3>
                                  <div class="flex flex-wrap gap-2">
                                    {data.streams!.slice(0, 3).map((stream) => (
                                            <div class="w-64">
                                                <ScheduleStreamCard stream={stream} type="left-bar" hover={false}
                                                                    client:only="solid-js"/>
                                            </div>
                                    ))}
                                  </div>
                              </div>

                              <div>
                                  <h3 class="text-xl font-bold mb-2">Schedule Stream Card with Left Bar and Hover Effect</h3>
                                  <div class="flex flex-wrap gap-2">
                                    {data.streams!.slice(0, 3).map((stream) => (
                                            <div class="w-64">
                                                <ScheduleStreamCard stream={stream} type="left-bar" hover={true}
                                                                    client:only="solid-js"/>
                                            </div>
                                    ))}
                                  </div>
                              </div>

                              <div>
                                  <h3 class="text-xl font-bold mb-2">Schedule Stream Card with Bottom Bar</h3>
                                  <div class="flex flex-wrap gap-2">
                                    {data.streams!.slice(0, 3).map((stream) => (
                                            <div class="w-64">
                                                <ScheduleStreamCard stream={stream} type="bottom-bar" hover={false}
                                                                    client:only="solid-js"/>
                                            </div>
                                    ))}
                                  </div>
                              </div>

                              <div>
                                  <h3 class="text-xl font-bold mb-2">Schedule Stream Card with Bottom Bar and Hover Effect</h3>
                                  <div class="flex flex-wrap gap-2">
                                    {data.streams!.slice(0, 3).map((stream) => (
                                            <div class="w-64">
                                                <ScheduleStreamCard stream={stream} type="bottom-bar" hover={true}
                                                                    client:only="solid-js"/>
                                            </div>
                                    ))}
                                  </div>
                              </div>

                              <div>
                                  <h3 class="text-xl font-bold mb-2">Schedule Stream Card with Top Bar</h3>
                                  <div class="flex flex-wrap gap-2">
                                    {data.streams!.slice(0, 3).map((stream) => (
                                            <div class="w-64">
                                                <ScheduleStreamCard stream={stream} type="top-bar" hover={false}
                                                                    client:only="solid-js"/>
                                            </div>
                                    ))}
                                  </div>
                              </div>

                              <div>
                                  <h3 class="text-xl font-bold mb-2">Schedule Stream Card with Top Bar and Hover Effect</h3>
                                  <div class="flex flex-wrap gap-2">
                                    {data.streams!.slice(0, 3).map((stream) => (
                                            <div class="w-64">
                                                <ScheduleStreamCard stream={stream} type="top-bar" hover={true}
                                                                    client:only="solid-js"/>
                                            </div>
                                    ))}
                                  </div>
                              </div>
                          </div>
                      </section>

                      <section>
                          <h2 class="text-2xl font-bold mb-4">Schedule Day Layouts</h2>
                          <div class="flex flex-col gap-4">
                              <div>
                                  <h3 class="text-xl font-bold mb-2">Horizontal Layout</h3>
                                  <ScheduleDayHorizontal day={data.days[0]} client:only="solid-js"/>
                              </div>

                              <div>
                                  <h3 class="text-xl font-bold mb-2">Vertical Layout</h3>
                                  <ScheduleDayVertical day={data.days[0]} client:only="solid-js"/>
                              </div>
                          </div>
                      </section>

                      <section>
                          <h2 class="text-2xl font-bold mb-4">Week 1</h2>
                          <WeekScheduleDesktopComponent week={data.weeks.week1} client:only="solid-js"/>
                          <h2 class="text-2xl font-bold mb-4">Week 2</h2>
                          <WeekScheduleDesktopComponent week={data.weeks.week2} client:only="solid-js"/>
                      </section>
                  </div>
    )
  }

</BaseLayout>
