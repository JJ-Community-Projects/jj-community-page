---
import PageShell from '../../layouts/PageShell.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import { Tile } from '../../components/ui/Tile'
---

<PageShell
  title="Privacy Policy - Jingle Jam Community Twitch Extension"
  description="Privacy policy of the Jingle Jam Community Twitch Panel Extension: it does not collect, store or share any personal or user-identifiable information."
  canonical="https://jinglejam.ostof.dev/twitch-extension/privacy"
>
  <div class="flex flex-col gap-3">
    <PageHeader
      title="Privacy Policy"
      subtitle="The Jingle Jam Community Twitch Panel Extension"
      back={{ href: '/twitch-extension', label: 'Twitch extensions' }}
    />
    <Tile>
      <div class="flex max-w-prose flex-col gap-3 text-sm sm:text-base">
        <p class="font-semibold">Effective Date: November 24th 2024</p>
        <p>
          The Jingle Jam Community Twitch Panel Extension respects your privacy and is committed to
          protecting it.
        </p>
        <p>
          This extension does <b>NOT</b> collect, store, or share any personal or user-identifiable
          information.
        </p>
        <p>
          If you have any questions or concerns regarding this privacy policy, feel free to contact
          me at <a class="font-medium underline" target="_blank" href="mailto:ostof13@gmail.com"
            >ostof13@gmail.com</a
          >.
        </p>
        <p>
          This privacy policy is subject to change. Please check this page for the latest privacy
          policy.
        </p>
        <p>Thank you for using The Jingle Jam Community Extension.</p>
      </div>
    </Tile>
  </div>
</PageShell>
