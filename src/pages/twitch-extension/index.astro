---
import { FaSolidTableColumns, FaSolidTv } from 'solid-icons/fa'
import PageShell from '../../layouts/PageShell.astro'
import FeedbackButtons from '../../components/layout/footer/FeedbackButtons.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import { Section, Tile } from '../../components/ui/Tile'
import { Button } from '../../components/ui/Button'
import {
  Carousel,
  OVERLAY_EXTENSION_URL,
  PANEL_EXTENSION_URL,
  overlayImages,
  panelImages,
} from '../../components/stream/ExtensionScreenshots'
---

<PageShell
  title="Jingle Jam Community Twitch Extensions: Panel & Overlay"
  description="Twitch panel and video overlay extensions for Jingle Jam streamers: show viewers the charities, community fundraisers and the Yogscast schedule. Not official."
  canonical="https://jinglejam.ostof.dev/twitch-extension"
>
  <div class="flex flex-col gap-3">
    <PageHeader
      title="Jingle Jam Community Twitch Extensions"
      subtitle="For everyone who takes part in the Jingle Jam and streams on Twitch: your viewers see the charities and the other community fundraisers. Feedback is always welcome."
    >
      <FeedbackButtons />
    </PageHeader>

    <Section title="Twitch Panel Extension">
      <FaSolidTableColumns slot="icon" />
      <Button slot="action" href={PANEL_EXTENSION_URL} target="_blank" brand="twitch" size="sm">
        Get it on Twitch
      </Button>
      <div class="flex flex-col items-center gap-3 text-sm sm:text-base">
        <p class="max-w-prose self-start">
          A panel that sits below your stream. Viewers can click a charity to visit its website, or
          a community fundraiser to visit their Twitch page. You can change the colour theme and the
          order of the tabs.
        </p>
        <Carousel
          client:visible
          images={panelImages}
          alt="JJ Twitch Panel Extension screenshot"
        />
        <a class="self-start font-medium underline" href="/twitch-extension/privacy"
          >Privacy Policy</a
        >
      </div>
    </Section>

    <Section title="Twitch Overlay Extension">
      <FaSolidTv slot="icon" />
      <Button slot="action" href={OVERLAY_EXTENSION_URL} target="_blank" brand="twitch" size="sm">
        Get it on Twitch
      </Button>
      <div class="flex flex-col items-center gap-3 text-sm sm:text-base">
        <p class="max-w-prose self-start">
          An overlay on top of the Twitch video player. It only shows while viewers hover over the
          player, and they can turn it off. It has the same charities, fundraisers and schedules as
          the panel.
        </p>
        <Carousel
          client:visible
          images={overlayImages}
          alt="JJ Twitch Overlay Extension screenshot"
        />
      </div>
    </Section>

    <Tile pad="sm">
      <p class="text-fg-muted text-center text-xs">
        Thanks to Nairdwood for making the extension assets, and to No1mann for the access to the
        Jingle Jam Donation Tracker.
      </p>
    </Tile>
  </div>
</PageShell>
