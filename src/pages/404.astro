---
import ErrorPage from '../layouts/ErrorPage.astro'
import { Button } from '../components/ui/Button'

// Unmatched paths and the pages that rewrite here (unknown user, team, schedule) answer 404.
export const prerender = false

const links = [
  { href: '/', label: 'Home' },
  { href: '/yogs', label: 'Yogscast schedule' },
  { href: '/community', label: 'Community' },
  { href: '/teams', label: 'Teams' },
]
---


<ErrorPage
  title="Page not found | Jingle Jam Community"
  description="This page doesn't exist on the Jingle Jam Community site."
  heading="Page not found"
  code="404"
>
  The page, creator, team or schedule you're looking for doesn't exist.
  <!-- Four links: 2×2 on phones (a row wraps 3 + 1), one centred row from sm up -->
  <div slot="actions" class="grid w-full grid-cols-2 gap-2 sm:flex sm:w-auto sm:flex-wrap sm:justify-center">
    {links.map(({ href, label }, i) => (
      <Button href={href} size="sm" variant={i === 0 ? 'primary' : 'secondary'}>{label}</Button>
    ))}
  </div>
</ErrorPage>
