---
import { serverClientPublic } from '../../lib/orpc/serverClient'
import { TeamsGrid } from '../../components/features/teams/public/TeamsGrid'
import BaseLayout4xl from '../../layouts/BaseLayout4xl.astro'
import TeamsIndexHeader from '../../components/features/teams/public/TeamsIndexHeader'

const { data: teams, error } = await serverClientPublic.teams.findVisible(
  {},
  {
    context: {
      locals: Astro.locals,
      request: Astro.request,
    },
  },
)
---

<BaseLayout4xl title="Teams - Jingle Jam Community">
  <!-- Error State -->
  {
    error && (
      <div class="bg-red-500 bg-opacity-20 p-4 rounded-lg text-white mb-6">
        <h2 class="text-xl font-semibold">Error Loading Teams</h2>
        <p>
          {error?.message || 'An unknown error occurred while loading teams.'}
        </p>
      </div>
    )
  }

  {
    teams && (
      <div class="w-full flex flex-col justify-center items-stretch gap-4 ">
        <TeamsIndexHeader client:only="solid-js" />
        <TeamsGrid teams={teams} client:only="solid-js" />
      </div>
    )
  }
</BaseLayout4xl>
