---
import {serverClientPublic} from "../../lib/orpc/serverClient";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {TeamsGrid} from "../../components/features/teams/public/TeamsGrid";

const {data, error} = await serverClientPublic.teams.findVisible({}, {
    context: {
      locals: Astro.locals,
      request: Astro.request,
    }
  }
);
---

<BaseLayout title="Teams - Jingle Jam Community">
    <div class="container-margins">
        <div class="section-spacing">
            <!-- Page Header -->
            <header class="bg-white rounded-xl p-4 shadow-md border-2 border-neutral-100 transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 text-center mb-12">
                <h1 class="~text-3xl/5xl font-babas text-neutral-800 mb-4">
                    Community Teams
                </h1>
            </header>

            <!-- Error State -->
          {error && (
                  <div class="bg-danger-50 border border-danger-200 rounded-xl p-6 mb-8">
                      <div class="flex items-center gap-3 mb-2">
                          <div class="w-6 h-6 bg-danger-500 rounded-full flex items-center justify-center">
                              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                                  <path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                              </svg>
                          </div>
                          <h2 class="~text-lg/xl font-semibold text-danger-700 font-poppins">
                              Error Loading Teams
                          </h2>
                      </div>
                      <p class="text-danger-600 ~text-sm/base font-poppins">
                        {error.message || "An unexpected error occurred while loading teams. Please try refreshing the page."}
                      </p>
                  </div>
          )}

            <!-- Teams Grid -->
          {!error && (
                  <TeamsGrid
                          teams={data || []}
                          client:load
                  />
          )}
        </div>
    </div>
</BaseLayout>
