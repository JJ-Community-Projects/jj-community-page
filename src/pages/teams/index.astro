---
import { serverClientPublic } from '../../lib/orpc/serverClient'
import { TeamsGrid } from '../../components/features/teams/public/TeamsGrid'
import PageShell from '../../layouts/PageShell.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import { Tile } from '../../components/ui/Tile'
import { Alert, EmptyState } from '../../components/ui/Status'
import {
  JJStartCountdown,
  JJStartCountdownTile,
  JJStartTimes,
} from '../../components/ui/Countdown'
import { getConfigYear } from '../../lib/utils/configYear'
import { upcomingJJYear } from '../../lib/utils/jjYear'

const [{ data: contentHidden }, configYear] = await Promise.all([
  serverClientPublic.overlays.visibility.getHidden(
    {},
    {
      context: {
        locals: Astro.locals,
        request: Astro.request,
      },
    },
  ),
  getConfigYear(),
])
const HIDE_CONTENT = contentHidden ?? true
const year = upcomingJJYear(configYear, HIDE_CONTENT)

const { data: teams, error } = await serverClientPublic.teams.findVisible(
  {},
  {
    context: {
      locals: Astro.locals,
      request: Astro.request,
    },
  },
)
---

<PageShell
  title={`Jingle Jam ${year} Teams | Jingle Jam Community`}
  description={`Teams of community streamers fundraising together for Jingle Jam ${year}: who is in each team and their upcoming streams. Community-run, not official.`}
>
  <div class="flex flex-col gap-3">
    <PageHeader
      title={`Jingle Jam ${year} Teams`}
      subtitle={HIDE_CONTENT ? 'Teams will be available when the Jingle Jam starts!' : undefined}
    />
    {HIDE_CONTENT ? (
      <Tile class="flex flex-col items-center gap-4 text-center">
        <p class="max-w-2xl text-sm sm:text-base">
          Teams are groups of community streamers who stream and fundraise together for the Jingle Jam.
          When Jingle Jam {year} starts on 1 December, this page lists every team, and each team's page
          shows its members and upcoming streams.
        </p>
        <JJStartCountdown client:only="solid-js" />
        <JJStartTimes client:only="solid-js" class="max-w-lg" />
      </Tile>
    ) : (
      <>
        {error && (
          <Alert tone="danger" title="Error loading teams">
            {error?.message || 'An unknown error occurred while loading teams.'}
          </Alert>
        )}
        {teams && teams.length > 0 && (
          <>
            <JJStartCountdownTile client:only="solid-js" />
            <TeamsGrid teams={teams} client:only="solid-js" />
          </>
        )}
        {teams && teams.length === 0 && (
          <Tile>
            <EmptyState title="No teams yet">Teams appear here once they are made public.</EmptyState>
          </Tile>
        )}
      </>
    )}
  </div>
</PageShell>
