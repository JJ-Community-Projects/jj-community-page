---
import {DebugJSONView} from "../../components/common/DebugJSONView";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {serverClientPublic} from "../../lib/orpc/client";
const {slug} = Astro.params
if (!slug) {
  return Astro.redirect('/teams')
}

const {data, error} = await serverClientPublic.teams.getBySlug({slug}, {
  locals: Astro.locals,
  request: Astro.request,
  env: Astro.locals.runtime.env
})

---
<BaseLayout>
  {
    error && (
                  <p>Error: {error.message}</p>
    )
  }
  {data && (
          <DebugJSONView client:only="solid-js" data={data} title="Debug Team"/>

  )
  }
</BaseLayout>
