---
import BaseLayout4xl from "../../layouts/BaseLayout4xl.astro";
import { serverClientPublic } from "../../lib/orpc/serverClient";
import { TeamHeader } from "../../components/features/teams/public/TeamHeader";
import { TeamMembersSection } from "../../components/features/teams/public/TeamMembersSection";
import { TeamNextStreamsSection } from "../../components/features/teams/public/TeamNextStreamsSection";
import { TeamNotFoundState } from "../../components/features/teams/public/TeamErrorState";
import { isNotFoundError } from "../../lib/utils/notFound";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/teams');
}
const slugLower = slug.toLowerCase();
if (slug !== slugLower) {
  return Astro.redirect(`/teams/${slugLower}`);
}

const context = { context: { locals: Astro.locals, request: Astro.request } } as const;

// All three in parallel; members and streams are only shown when the team was found.
const [t, m, s] = await Promise.all([
  serverClientPublic.teams.getBySlug({ slug }, context),
  serverClientPublic.teams.getMembers({ slug }, context),
  serverClientPublic.teams.getTeamNextStreams({ slug, limit: 6, unique: true }, context),
]);
const { data: team, error: teamError } = t;
// Unknown or hidden team: a real 404, not a 200 with the "not found" state.
if ((!teamError && !team) || isNotFoundError(teamError)) {
  return Astro.rewrite('/404');
}
if (teamError) {
  Astro.response.status = 500;
  console.error('Team fetch error:', teamError);
}

const { data: members, error: membersError } = m;
const { data: nextStreams, error: streamsError } = s;

// Title and description from the team; a long team description is cut to snippet length
const pageTitle = team ? `${team.name} - Jingle Jam Team | Jingle Jam Community` : 'Team | Jingle Jam Community';
const teamDescription = team?.description?.replace(/\s+/g, ' ').trim() || undefined;
const pageDescription = teamDescription
  ? teamDescription.length > 155 ? `${teamDescription.slice(0, 154).trimEnd()}…` : teamDescription
  : team ? `${team.name} is a Jingle Jam community team: see its members and their upcoming streams.` : undefined;

// Semantic DS tokens with safe fallbacks; keep island prop contract (strings)
const teamColors = {
  primaryColor: 'var(--jj-color-primary-500, #E30E50)',
  accentColor: 'var(--jj-color-accent-500, #3584BF)'
};
---

<BaseLayout4xl title={pageTitle} description={pageDescription} robots="noindex,follow">
  <main class="w-full flex flex-col justify-center items-stretch gap-4">
    {(!team || teamError) ? (
      <div class="w-full">
        <TeamNotFoundState client:only="solid-js" />
      </div>
    ) : (
      <>
        {/* Hero/Header: static, so the h1 is in the server HTML */}
        <TeamHeader team={team} memberCount={members?.members.length ?? 0} teamColors={teamColors} />

        {(!membersError && members) ? (
          <TeamMembersSection client:only="solid-js" members={members.members} teamColors={teamColors} />
        ) : membersError ? (
          <div class="bg-white rounded-xl p-4 shadow-md border-2 border-danger-200">
            <p class="text-danger-700 text-center">Unable to load team members. Please try again.</p>
          </div>
        ) : null}

        {(!streamsError && nextStreams && nextStreams.length > 0) ? (
          <TeamNextStreamsSection client:only="solid-js" streams={nextStreams} teamSlug={slug} teamColors={teamColors} />
        ) : streamsError ? (
          <div class="bg-white rounded-xl p-4 shadow-md border-2 border-danger-200">
            <p class="text-danger-700 text-center">Unable to load upcoming streams. Please try again.</p>
          </div>
        ) : null}
      </>
    )}
  </main>
</BaseLayout4xl>
