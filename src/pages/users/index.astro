---
import { serverClientPublic } from '../../lib/orpc/serverClient'
import UsersPage from '../../components/features/users/public/UsersPage'
import BaseLayout4xl from '../../layouts/BaseLayout4xl.astro'
import UsersIndexHeader from '../../components/features/users/public/UsersIndexHeader'

// Get all users in UserPageUI format
const { data, error } = await serverClientPublic.users.getAllUsersWithTags(
  {},
  {
    context: {
      locals: Astro.locals,
      request: Astro.request,
    },
  },
)
---

<BaseLayout4xl title="Users - Jingle Jam Community">
  {
    error && (
      <div class="bg-red-500 bg-opacity-20 p-4 rounded-lg text-white mb-6">
        <h2 class="text-xl font-semibold">Error Loading Users</h2>
        <p>
          {error?.message || 'An unknown error occurred while loading users.'}
        </p>
      </div>
    )
  }

  {
    data && data.length > 0 && (
      <div class="w-full flex flex-col justify-center items-stretch gap-4 ">
        <UsersIndexHeader client:only="solid-js" />
        <UsersPage data={data} client:only="solid-js" />
      </div>
    )
  }
</BaseLayout4xl>
