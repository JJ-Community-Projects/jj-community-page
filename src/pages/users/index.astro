---
import { serverClientPublic } from "../../lib/orpc/serverClient";
import BaseLayout from "../../layouts/BaseLayout.astro";
import UsersPage from "../../components/features/users/public/UsersPage";

// Get all users in UserPageUI format
const { data, error } = await serverClientPublic.users.getAllUsers({}, {
  locals: Astro.locals,
  request: Astro.request,
  env: Astro.locals.runtime.env
})
---
<BaseLayout title="Users - Jingle Jam Community">

  {error && (
          <div class="bg-red-500 bg-opacity-20 p-4 rounded-lg text-white mb-6">
              <h2 class="text-xl font-semibold">Error Loading Users</h2>
              <p>{error?.message || "An unknown error occurred while loading users."}</p>
          </div>)}

  {data && <UsersPage data={data} client:only="solid-js" />}
</BaseLayout>
