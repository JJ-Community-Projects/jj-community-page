---
import BaseLayout from "../layouts/BaseLayout.astro";
import {TiltifyLoginButton} from "../components/features/auth/common/TiltifyLoginButton";
import {Show, createSignal} from "solid-js";

const {user, session} = Astro.locals
if (session) {
  return Astro.redirect(`/admin`);
}
---

<BaseLayout>
    <div class="min-h-screen flex justify-center px-4 py-8">
        <div class="max-w-md w-full space-y-6">
            <!-- Hero Section -->
            <div class="text-center space-y-4">
                <h1 class="~text-2xl/4xl font-bold font-babas text-white">
                    Login
                </h1>
                <p class="~text-base/lg text-white/80 font-poppins">
                    Join the community fundraising effort
                </p>
            </div>

            <!-- Login Card -->
            <div class="bg-white rounded-xl p-8 border-2 border-white/20 shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
                <!-- Community Notice -->
                <div class="mb-6 p-4 bg-primary/10 border border-primary/30 rounded-lg">
                    <div class="flex items-start gap-3">
                        <div class="flex-shrink-0 w-5 h-5 bg-primary/20 rounded-full flex items-center justify-center mt-0.5">
                            <div class="w-2 h-2 bg-primary rounded-full"/>
                        </div>
                        <div class="text-sm text-neutral-700">
                            <p class="font-medium mb-1">Community Project</p>
                            <p class="text-neutral-600">This is a community-run project, not officially affiliated with Jingle Jam.</p>
                        </div>
                    </div>
                </div>

                <!-- Login Button -->
                <div class="space-y-4">
                    <TiltifyLoginButton client:only="solid-js" />

                    <!-- Quick Info -->
                    <div class="text-center space-y-2">
                        <p class="~text-sm/base text-neutral-500">
                            No account needed to view schedules
                        </p>
                        <button
                            id="toggle-more-info"
                            class="px-4 py-2 bg-neutral-200 text-neutral-700 rounded-md font-medium hover:bg-neutral-300 shadow-sm hover:shadow-md focus:ring-2 focus:ring-neutral-500 focus:ring-offset-2 transition-all duration-200 transform active:scale-95 ~text-sm/base outline-none"
                        >
                            Why do I need an account?
                        </button>
                    </div>

                    <!-- Footer inside card -->
                    <div class="text-center pt-4 border-t border-white/20">
                        <p class="~text-xs/sm text-neutral-500">
                            By logging in, you agree to our community guidelines
                        </p>
                    </div>
                </div>
            </div>

            <!-- Progressive Disclosure - Hidden by Default -->
            <div id="more-info" class="hidden space-y-4">
                <!-- Account Purpose -->
                <div class="bg-white rounded-xl p-6 border-2 border-white/10 shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
                    <h3 class="~text-lg/xl font-semibold font-poppins text-neutral-700 mb-3">
                        Account Purpose
                    </h3>
                    <ul class="space-y-2 ~text-sm/base text-neutral-600">
                        <li class="flex items-start gap-2">
                            <span class="text-accent mt-1">•</span>
                            Active participation in community fundraising
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-accent mt-1">•</span>
                            Schedule and stream management
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-accent mt-1">•</span>
                            Community collaboration tools
                        </li>
                    </ul>
                </div>

                <!-- Terms Summary -->
                <div class="bg-white rounded-xl p-6 border-2 border-white/10 shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
                    <h3 class="~text-lg/xl font-semibold font-poppins text-neutral-700 mb-3">
                        Community Guidelines
                    </h3>
                    <div class="space-y-3 ~text-sm/base text-neutral-600">
                        <div class="flex items-start gap-2">
                            <span class="text-warning mt-1">•</span>
                            <div>
                                <p class="font-medium text-neutral-700">Content Moderation</p>
                                <p>Admins may edit inappropriate content with user notification</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="text-danger mt-1">•</span>
                            <div>
                                <p class="font-medium text-neutral-700">Zero Tolerance</p>
                                <p>Impersonation results in immediate ban</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-t border-neutral-200">
                        <p class="~text-xs/sm text-neutral-500">
                            Questions? Contact <span class="text-accent font-medium">@Ostof</span> on Discord
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<script>
  // Simple progressive disclosure without additional dependencies
  document.addEventListener('DOMContentLoaded', function() {
    const toggleButton = document.getElementById('toggle-more-info');
    const moreInfo = document.getElementById('more-info');

    if (toggleButton && moreInfo) {
      toggleButton.addEventListener('click', function(e) {
        e.preventDefault();
        moreInfo.classList.toggle('hidden');
        const isHidden = moreInfo.classList.contains('hidden');
        toggleButton.textContent = isHidden ? 'Why do I need an account?' : 'Hide details';
      });
    }
  });
</script>
