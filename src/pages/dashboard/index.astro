---
import {serverClientPrivate} from "../../lib/orpc/serverClient";
import PageShell from '../../layouts/PageShell.astro'
import {UserAdminDashboardPage} from "../../components/features/users/user-dashboard/UserAdminDashboardPage.tsx";

const {session, user} = Astro.locals
if (session === null) {
  return Astro.redirect("/");
}
const getCurrentUser = serverClientPrivate.users.getCurrentUser
const {data: userData, error} = await getCurrentUser({}, {
  context: {
    locals: Astro.locals,
    request: Astro.request,
  },
})

console.log('userData', userData);
console.log('error', error);

if (!userData) {
  return Astro.redirect("/");
}
---
<PageShell width="wide">
    <UserAdminDashboardPage user={user} client:only="solid-js"/>
</PageShell>
