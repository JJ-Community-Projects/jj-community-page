---
import {
  FaSolidCircleInfo,
  FaSolidHeart,
  FaSolidToolbox,
  FaSolidUser,
} from 'solid-icons/fa'
// Rendered on demand: the year comes from the config and the visibility flag
export const prerender = false
import PageShell from '../layouts/PageShell.astro'
import { PageHeader } from '../components/ui/PageHeader'
import { Section, Tile } from '../components/ui/Tile'
import { Button } from '../components/ui/Button'
import { JJStartCountdown, JJStartTimes } from '../components/ui/Countdown'
import { serverClientPublic } from '../lib/orpc/serverClient'
import { getConfigYear } from '../lib/utils/configYear'
import { upcomingJJYear } from '../lib/utils/jjYear'

const [{ data: contentHidden }, configYear] = await Promise.all([
  serverClientPublic.overlays.visibility.getHidden(
    {},
    { context: { locals: Astro.locals, request: Astro.request } },
  ),
  getConfigYear(),
])
const year = upcomingJJYear(configYear, contentHidden ?? true)
---

<PageShell
  title={`Jingle Jam ${year} Schedule & Timetable (Yogscast + Community)`}
  description={`Jingle Jam ${year} schedule and timetable in your timezone: Yogscast and community streams, fundraisers and stream overlays. Community-run, not official.`}
  canonical="https://jinglejam.ostof.dev"
>
  <div class="flex flex-col gap-3">
    <PageHeader
      title={`The Jingle Jam ${year} Community`}
      subtitle="A central place to showcase the streams of the Jingle Jam!"
    />

    <Tile class="flex flex-col items-center gap-3">
      <JJStartCountdown client:only="solid-js" />
      <JJStartTimes client:only="solid-js" class="max-w-lg" />
    </Tile>

    <Section title="What is this site?">
      <FaSolidCircleInfo slot="icon" />
      <div class="flex flex-col gap-3 text-sm sm:text-base">
        <p>
          A community hub that brings together streams, schedules, and
          fundraising for the Jingle Jam.
        </p>
        <ul class="list-disc space-y-1 pl-5">
          <li>
            <b>Overview of community fundraisers</b>: see totals and progress
            from community Tiltify campaigns.
          </li>
          <li>
            <b>Schedules of streamers</b> using this site: quickly find who is
            live and what's coming up.
          </li>
        </ul>
        <p class="text-fg-muted text-xs">
          Disclaimer: This is a community-run project and is not affiliated
          with, endorsed by, or sponsored by Jingle Jam or any associated
          organizations.
        </p>
      </div>
    </Section>

    <Section title="Tools without an account">
      <FaSolidToolbox slot="icon" />
      <div class="flex flex-col gap-3 text-sm sm:text-base">
        <p>For fundraisers and streamers, no account needed:</p>
        <ul class="grid list-disc gap-2 pl-5 sm:grid-cols-2 sm:gap-x-6">
          <li>
            <b>Fundraiser overview page</b>: if you have a <a
              class="font-medium underline"
              href="https://jinglejam.tiltify.com">Jingle Jam fundraiser</a
            >, it automatically appears on the <a
              class="font-medium underline"
              href="/community">fundraisers page</a
            > and in the <a class="font-medium underline" href="/twitch-extension"
              >Twitch extension</a
            > once the Jingle Jam has started.
          </li>
          <li><b>OBS overlays</b>: drop-in overlays for donations and schedules.</li>
          <li>
            <b>Twitch extension</b>: much of this data is also available in the
            Jingle Jam Community Twitch extension.
          </li>
        </ul>
        <div>
          <Button href="/stream-resources" size="sm">Open the stream resources</Button>
        </div>
      </div>
    </Section>

    <Section title="Tools with an account">
      <FaSolidUser slot="icon" />
      <div class="flex flex-col gap-3 text-sm sm:text-base">
        <p>For fundraisers and streamers who log in:</p>
        <ul class="grid list-disc gap-2 pl-5 sm:grid-cols-2 sm:gap-x-6">
          <li><b>User profile</b>: showcase your links and fundraising info.</li>
          <li><b>Friends</b>: highlight and collaborate with other creators.</li>
          <li><b>Teams</b>: group up for joint schedules.</li>
          <li><b>More OBS overlays</b>: drop-in overlays for donations and schedules.</li>
        </ul>
        <div>
          <Button href="/login" variant="primary" size="sm">Log in to get started</Button>
        </div>
      </div>
    </Section>

    <Section title="Special thanks">
      <FaSolidHeart slot="icon" />
      <p class="text-sm sm:text-base">
        Special thanks to <a
          href="https://www.twitch.tv/no1mann"
          class="font-medium underline">No1mann</a
        > for helping to expand the features.
      </p>
    </Section>
  </div>
</PageShell>
