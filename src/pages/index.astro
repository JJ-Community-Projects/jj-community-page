---
import {
  MainCountdownSimple,
  MainJJStartTimes,
} from '../components/common/ui/MainHeader.tsx'
const prerender = true
import BaseLayout4xl from '../layouts/BaseLayout4xl.astro'
import ShareBanner from '../components/shared/ShareBanner.astro'
---

<BaseLayout4xl
  title="Jingle Jam Community - Fundraising, Streams & Schedule"
  description="Discover Jingle Jam 2025 streams, creators, and fundraising tools - interactive schedule in your timezone and resources for streamers."
  canonical="https://jinglejam.ostof.dev"
>
  <div
    class={'flex w-full flex-col items-center gap-1 rounded-xl border border-white/10 bg-white/5 p-4 text-center text-white text-white/90 sm:p-4'}
  >
    <div class="flex flex-col items-center justify-center text-white">
      <h1 class="w-full text-center ~text-2xl/4xl">The Jingle Jam Community</h1>
      <h2 class="text-center ~text-lg/xl">
        A central place to showcase the streams of the Jingle Jam!
      </h2>
    </div>

    <div class="w-full">
      <MainCountdownSimple client:only="solid-js" />
    </div>

    <div class="w-full">
      <MainJJStartTimes client:only="solid-js" />
    </div>
  </div>

  <div class="flex flex-col gap-6 pt-4">
    <!-- Summary section -->
    <section
      class="text-white/90 bg-white/5 border border-white/10 rounded-xl p-4 sm:p-6"
    >
      <h2 class="text-xl sm:text-2xl font-semibold text-white">
        What is this site?
      </h2>
      <p class="mt-2">
        A community hub that brings together streams, schedules, and fundraising
        for the Jingle Jam.
      </p>
      <ul class="mt-4 list-disc pl-5 space-y-1">
        <li>
          <b>Overview of community fundraiser</b> — see totals and progress from
          community Tiltify campaigns.
        </li>
        <li>
          <b>Schedules of streamers</b> using this site — quickly find who is live
          and what’s coming up.
        </li>
      </ul>
      <p class="mt-4 text-xs sm:text-sm text-white/60">
        Disclaimer: This is a community‑run project and is not affiliated with,
        endorsed by, or sponsored by Jingle Jam or any associated organizations.
      </p>
    </section>

    <!-- Streamer features section -->
    <section
      class="text-white/90 bg-white/5 border border-white/10 rounded-xl p-4 sm:p-6"
    >
      <h2 class="text-xl sm:text-2xl font-semibold text-white">
        For Fundraisers/Streamers without an account
      </h2>
      <p>Tools available without an account:</p>
      <ul class="mt-3 grid gap-x-4 gap-2 sm:grid-cols-2 list-disc pl-5">
        <li>
          <b>Fundraiser overview page</b> - If you have a <a class="underline" href="https://jinglejam.tiltify.com">Jingle Jam Fundraiser</a> your fundraiser will automatically appear on the <a class="underline" href="/fundraisers">Fundraisers page</a> and <a class="underline" href="/stream-resources">Twitch extension</a> once the Jingle Jam has started.</li>
        <li>
          <b>OBS Overlays</b> - drop-in overlays for donations and schedules.
        </li>
        <li>
          <b>Twitch Extension</b> - Much of this data is also available via the Jingle
          Jam Community Twitch Extension
        </li>
      </ul>
      <a class="underline pt-2" href="/stream-resources"
        >Visit the stream resources page to access these tools</a
      >

    </section>

    <!-- Streamer with account features section -->
    <section
      class="text-white/90 bg-white/5 border border-white/10 rounded-xl p-4 sm:p-6"
    >
      <h2 class="text-xl sm:text-2xl font-semibold text-white">
        For Fundraisers/Streamers with an account
      </h2>
      <p>
        Tools available with an account:
      </p>
      <ul class="mt-3 grid gap-x-4 gap-2 sm:grid-cols-2 list-disc pl-5">
        <li><b>User profile</b> — showcase your links and fundraising info.</li>
        <li><b>Friends</b> — highlight and collaborate with other creators.</li>
        <li><b>Teams</b> — group up for joint schedules.</li>
        <li>
          <b>More OBS Overlays</b> — drop-in overlays for donations and schedules.
        </li>
      </ul>
      <div class="mt-4 flex justify-center">
        <a
          href="/login"
          class="inline-flex items-center rounded-md border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white hover:bg-white/15 transition-colors"
        >
          Log in to get started
        </a>
      </div>
    </section>

    <!-- Special thanks -->
    <section
      class="text-white/80 bg-white/5 border border-white/10 rounded-xl p-4 sm:p-6"
    >
      <h2 class="text-xl sm:text-2xl font-semibold text-white">
        Special thanks
      </h2>
      <p class="mt-2 text-sm">
        Special thanks to <a
          href="https://www.twitch.tv/no1mann"
          class="underline hover:text-accent-50 transition-all">No1mann</a
        > for helping to expand the features.
      </p>
    </section>
  </div>
</BaseLayout4xl>
