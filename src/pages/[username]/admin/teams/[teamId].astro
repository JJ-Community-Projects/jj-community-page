---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {TeamDetail} from "../../../../components/admin/teams/TeamDetail";
import {AdminTeamDetail} from "../../../../components/admin/teams/teamAdmin/AdminTeamDetail";
import {teamsTable} from "../../../../lib/db/schema/schema.ts";
import {eq} from "drizzle-orm";
import {getDB} from "../../../../lib/db/db.ts";

const {session, user} = Astro.locals
if (session === null) {
  return Astro.redirect("/");
}

// Verify the user has access to this page
if (Astro.params.username !== user.tiltifyName) {
  return Astro.redirect(`/${user.tiltifyName}/admin/teams`);
}

// Get team ID from URL
const teamId = parseInt(Astro.params.teamId || "0");
if (!teamId) {
  return Astro.redirect(`/${user.tiltifyName}/admin/teams`);
}

// Get team details to check if user is the owner
let isOwner = false;
try {
  const db = getDB(Astro);
  const team = await db.select()
    .from(teamsTable)
    .where(eq(teamsTable.id, teamId))
    .get();

  if (!team) {
    return Astro.redirect(`/${user.tiltifyName}/admin/teams`);
  }

  // Check if the current user is the team owner
  isOwner = team.ownerId === user.id;
} catch (e) {
  console.error("Error fetching team:", e);
  return Astro.redirect(`/${user.tiltifyName}/admin/teams`);
}
---

<BaseLayout>
  {isOwner ? (
          <AdminTeamDetail user={user} teamId={teamId} client:only="solid-js"/>
  ) : (
          <TeamDetail user={user} teamId={teamId} client:only="solid-js"/>
  )}
</BaseLayout>
