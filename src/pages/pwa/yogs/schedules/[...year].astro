---
import PageShell from '../../../../layouts/PageShell.astro'
import { PageHeader } from '../../../../components/ui/PageHeader'
export const prerender = false;
import {getCollection, getEntry} from 'astro:content';
import {getYogsScheduleFromContent} from "../../../../content/getYogsScheduleFromContent.ts";
import {compactYogsSchedule} from "../../../../lib/utils/compactYogsSchedule.ts";
import {YogsResponsiveSchedule} from "../../../../components/yogs-pages/schedule/YogsResponsiveSchedule.tsx";
import YogsArchiveNav from '../../../../components/yogs-pages/common/YogsArchiveNav.astro'

const year = Astro.params.year
const entry = year ? await getEntry('schedules', year) : undefined

if (!entry || !entry.data.visible) {
  return Astro.redirect('/yogs')
}

// Same loader and island as /yogs/archive/[year]
const schedule = await getYogsScheduleFromContent(Number(year))

// The year switcher, with links that stay in the PWA
const archiveYears = (await getCollection('schedules'))
  .filter((schedule) => schedule.data.visible && /^\d{4}$/.test(schedule.id))
  .map((schedule) => Number(schedule.id))
  .sort((a, b) => b - a)
---

<PageShell width="full" nav="pwa" og={false}
        title={`The Yogscast Jingle Jam ${year} Schedule`}
        description={`The Yogscast Jingle Jam ${year} Interactive Schedule made by the Community`}
        canonical={`https://jinglejam.ostof.dev/yogs/archive/${year}`}
>
    <div class="flex w-full flex-col items-center gap-4">
        <PageHeader
            title={`Yogscast Jingle Jam ${year} Schedule`}
            back={{ href: '/pwa/yogs', label: 'Current schedule' }}
        />
        <YogsArchiveNav years={archiveYears} current={Number(year)} base="/pwa/yogs/schedules" />
        <YogsResponsiveSchedule
            schedule={compactYogsSchedule(schedule)}
            showCreators
            client:load
        />
    </div>
</PageShell>
