---
export const prerender = false;
import {loadScheduleFromContent} from "../../../content/loadScheduleFromContent";
import {loadAllCreatorsFromContent} from "../../../content/loadCreatorsFromContent";
import {YogsCurrentScheduleLoader} from "../../../components/yogs-pages/schedule/YogsCurrentScheduleLoader";

import PageShell from '../../../layouts/PageShell.astro'
import { getConfigYear } from '../../../lib/utils/configYear.ts'

const creators = await loadAllCreatorsFromContent();

const year = await getConfigYear();

const fallbackSchedule = await loadScheduleFromContent('2024')
const filter = Astro.url.searchParams.get('filter') || '';
const filterCreators = () => {
  if (filter === '') {
    return null;
  }
  const ids = filter.split(',')
  return creators.filter(creator => ids.includes(creator.id));
}

const filteredCreators = filterCreators();

let description = `Yogscast Jingle Jam ${year} Interactive Schedule with additional information made by the Community.`

if (filteredCreators) {
  if (filteredCreators.length === 1) {
    description = `The Yogscast Jingle Jam ${year} Schedule for ${filteredCreators[0].name}`
  } else if (filteredCreators.length <= 3) {
    let nameStr = ''
    const filteredCreatorsLastIndex = filteredCreators.length - 1
    for (let i = 0; i < filteredCreators.length; i++) {
      nameStr += filteredCreators[i].name
      if (i < filteredCreatorsLastIndex - 1) {
        nameStr += ', '
      } else if (i === filteredCreatorsLastIndex - 1) {
        nameStr += ' and '
      }
    }
    description = `The Yogscast Jingle Jam ${year} Schedule for ${nameStr}`
  } else {
    let nameStr = ''
    for (let i = 0; i < 3; i++) {
      nameStr += filteredCreators[i].name
      if (i < 2) {
        nameStr += ', '
      } else {
        nameStr += ' and more'
      }
    }
    description = `The Yogscast Jingle Jam ${year} Schedule for ${nameStr}`
  }
}
---

<PageShell width="full" nav="pwa" og={false}
        title={`The Yogscast Jingle Jam ${year} Schedule`}
        description={description}
        canonical="https://jinglejam.ostof.dev/yogs"
>
    <div class={'min-h-32'}>
        <YogsCurrentScheduleLoader client:only="solid-js" creators={creators} fallbackSchedule={fallbackSchedule!}/>
    </div>
</PageShell>
