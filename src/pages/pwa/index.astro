---
import PageShell from '../../layouts/PageShell.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import {CommunityPage} from "../../components/features/community/CommunityPage";
import {serverClientPublic} from "../../lib/orpc/serverClient";

// The tag search gets the catalog from the page (no public HTTP route)
const {data: tagCatalog} = await serverClientPublic.tags.catalog(
  {},
  {context: {locals: Astro.locals, request: Astro.request}},
);
---
<PageShell nav="pwa" og={false}
  title="The Jingle Jam Community"
  description="A central place to showcase the streams of the Jingle Jam!"
  canonical="https://jinglejam.ostof.dev/community"
>
  <div class="flex flex-col gap-3">
    <PageHeader title="Community" subtitle="Fundraisers and upcoming streams" />
    <CommunityPage client:only="solid-js" tagCatalog={tagCatalog?.tags}/>
  </div>
</PageShell>
