/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jj-community-page",
  // "main": "./dist/_worker.js/index.js",
  "main": "./src/worker.js",
  "compatibility_date": "2025-04-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ScheduleEditorDO",
        "UserDO",
        "TeamDO",
        "JingleJamData",
        "UserRateLimiter",
        "TwitchAPIDO"
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      // TODO
      {
        "name": "ScheduleEditorDO",
        "class_name": "ScheduleEditorDO"
      },
      {
        "name": "JingleJamData",
        "class_name": "JingleJamData"
      },
      {
        "name": "UserDO",
        "class_name": "UserDO"
      },
      {
        "name": "TeamDO",
        "class_name": "TeamDO"
      },
      {
        "name": "UserRateLimiter",
        "class_name": "UserRateLimiter"
      },
      {
        "name": "TwitchAPIDO",
        "class_name": "TwitchAPIDO"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beta-d1-jj",
      "database_id": "b32d1f6f-5f53-487f-a355-4d9e9b9a0658",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "9f2c6f601baf4a07a89a5887a641e4fb"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "TWITCH_LIVE_CHECK",
        "binding": "TWITCH_LIVE_CHECK"
      },
      {
        "queue": "YOUTUBE_LIVE_CHECK",
        "binding": "YOUTUBE_LIVE_CHECK"
      },
      {
        "queue": "TWITCH_LIVE_NOTIFIER",
        "binding": "TWITCH_LIVE_NOTIFIER"
      }
    ],
    "consumers": [
      {
        "queue": "TWITCH_LIVE_CHECK",
        "max_batch_size": 100,
        "max_batch_timeout": 30
      },
      {
        "queue": "YOUTUBE_LIVE_CHECK",
        "max_batch_size": 5,
        "max_batch_timeout": 30
      },
      {
        "queue": "TWITCH_LIVE_NOTIFIER",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "DEV",
    "TWITCH_CLIENT_ID": "<PLACEHOLDER>",
    "TWITCH_CLIENT_SECRET": "<PLACEHOLDER>",
    "TILTIFY_CLIENT_ID": "<PLACEHOLDER>",
    "TILTIFY_SECRET": "<PLACEHOLDER>",
    "TILTIFY_API": "<PLACEHOLDER>",
    "TILTIFY_REDIRECT_URI": "<PLACEHOLDER>",
    "JJ_DASHBOARD_URL": "<PLACEHOLDER>",
    "YOUTUBE_API_KEY": "<PLACEHOLDER>"
  },
  "triggers": {
    "crons": [
      "*/2 * * * *" // every 2 minutes
    ]
  },
  "env": {
    "prod": {
      "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist"
      },
      "routes": [
        {
          "pattern": "beta.jinglejam.ostof.dev",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "JingleJamData",
            "ScheduleEditorDO",
            "UserDO",
            "TeamDO",
            "UserRateLimiter"
          ]
        }
      ],
      "durable_objects": {
        "bindings": [
          // TODO
          {
            "name": "ScheduleEditorDO",
            "class_name": "ScheduleEditorDO"
          },
          {
            "name": "JingleJamData",
            "class_name": "JingleJamData"
          },
          {
            "name": "UserDO",
            "class_name": "UserDO"
          },
          {
            "name": "TeamDO",
            "class_name": "TeamDO"
          },
          {
            "name": "UserRateLimiter",
            "class_name": "UserRateLimiter"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "beta-d1-jj",
          "database_id": "7385a91b-14db-4254-8906-edf20d6bb68c",
          "migrations_dir": "drizzle"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "9f2c6f601baf4a07a89a5887a641e4fb"
        }
      ],
      "vars": {
        "ENVIRONMENT": "PRDD",
        "TWITCH_CLIENT_ID": "<PLACEHOLDER>",
        "TWITCH_CLIENT_SECRET": "<PLACEHOLDER>",
        "TILTIFY_CLIENT_ID": "<PLACEHOLDER>",
        "TILTIFY_SECRET": "<PLACEHOLDER>",
        "TILTIFY_API": "<PLACEHOLDER>",
        "TILTIFY_REDIRECT_URI": "<PLACEHOLDER>",
        "JJ_DASHBOARD_URL": "<PLACEHOLDER>",
        "YOUTUBE_API_KEY": "<PLACEHOLDER>"
      }
    },
    "beta": {
      "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist"
      },
      "routes": [
        {
          "pattern": "beta.jinglejam.ostof.dev",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "ScheduleEditorDO",
            "UserDO",
            "TeamDO",
            "JingleJamData"
          ]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": [
            "UserRateLimiter"
          ]
        }
      ],
      "durable_objects": {
        "bindings": [
          // TODO
          {
            "name": "ScheduleEditorDO",
            "class_name": "ScheduleEditorDO"
          },
          {
            "name": "JingleJamData",
            "class_name": "JingleJamData"
          },
          {
            "name": "UserDO",
            "class_name": "UserDO"
          },
          {
            "name": "TeamDO",
            "class_name": "TeamDO"
          },
          {
            "name": "UserRateLimiter",
            "class_name": "UserRateLimiter"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "beta-d1-jj",
          "database_id": "b32d1f6f-5f53-487f-a355-4d9e9b9a0658",
          "migrations_dir": "drizzle"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "9f2c6f601baf4a07a89a5887a641e4fb"
        }
      ],
      "vars": {
        "ENVIRONMENT": "BETA",
        "TWITCH_CLIENT_ID": "<PLACEHOLDER>",
        "TWITCH_CLIENT_SECRET": "<PLACEHOLDER>",
        "TILTIFY_CLIENT_ID": "<PLACEHOLDER>",
        "TILTIFY_SECRET": "<PLACEHOLDER>",
        "TILTIFY_API": "<PLACEHOLDER>",
        "TILTIFY_REDIRECT_URI": "<PLACEHOLDER>",
        "JJ_DASHBOARD_URL": "<PLACEHOLDER>",
        "YOUTUBE_API_KEY": "<PLACEHOLDER>"
      }
    }
  }


  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": { "mode": "smart" },

  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */

  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  // "vars": { "MY_VARIABLE": "production_value" },
  /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */

  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" },

  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
