    "@tanstack/query-db-collection": "^0.2.0",
    "@tanstack/solid-db": "^0.1.1",
    "@tanstack/solid-query": "^5.83.1",
    "arctic": "^3.7.0",
    "astro": "^5.8.1",
    "astro-zod-to-json-schema": "^0.0.2",
    "debug": "^4.4.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.41.0",
    "echarts": "^5.6.0",
