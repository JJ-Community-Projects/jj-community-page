{
  "name": "jj-community-page",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node before.js && npm run content:update-twitch && astro dev",
    "start": "astro dev --verbose",
    "build": "astro build",
    "check": "astro check",
    "check:ui": "node check-ui-classes.ts",
    "sync": "astro sync",
    "prettier": "npx prettier . --write",
    "prettier-check": "npx prettier . --check",
    "preview": "astro build && astro preview --port 3000",
    "astro": "astro",
    "cf:dev": "astro dev",
    "cf:deploy": "node before.js && npm run content:update-twitch && NODE_ENV=production CLOUDFLARE_ENV=prod astro build && wrangler deploy",
    "cf:deploy:beta": "node before.js && npm run content:update-twitch && NODE_ENV=production CLOUDFLARE_ENV=beta astro build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:d1:local": "wrangler d1 migrations apply DB --local",
    "drizzle:d1:beta": "wrangler d1 migrations apply DB --remote --env beta",
    "drizzle:d1:prod": "wrangler d1 migrations apply DB --remote --env prod",
    "deployCurrentScheduletoFirestore": "node deployCurrentScheduleToFirestore.js",
    "updateTwitchUser": "node updateTwitchUser.js",
    "content:update-twitch": "tsx updateTwitchUserContent.ts",
    "generate:yogs-images": "node generateYogsSchedulePreview.js",
    "generate:headliner-days": "tsx scripts/generateHeadlinerScheduleDays.ts",
    "openapi-generator-cli:tiltify": "openapi-generator-cli generate -i ./src/lib/externalAPI/tiltify/spec.json -g typescript-fetch -o ./src/lib/externalAPI/tiltify/api/ --additional-properties=npmName=tiltify",
    "test": "vitest run --project unit --project workers --project workers-ws",
    "test:e2e": "astro build && vitest run --project e2e",
    "test:browser": "astro build && playwright test -c test/browser/playwright.config.ts",
    "test:browser:headed": "astro build && BROWSER_SLOWMO=${BROWSER_SLOWMO:-300} playwright test -c test/browser/playwright.config.ts --headed --workers=1",
    "test:update": "npm run test -- -u",
    "verify": "npm run test && npm run check:ui && astro build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/solid-js": "^7.1.0",
    "@cf-wasm/photon": "^0.2.2",
    "@kobalte/core": "^0.13.14",
    "@orpc/client": "1.15.7",
    "@orpc/contract": "1.15.7",
    "@orpc/experimental-durable-iterator": "1.15.7",
    "@orpc/json-schema": "1.15.7",
    "@orpc/openapi": "1.15.7",
    "@orpc/server": "1.15.7",
    "@orpc/tanstack-query": "1.15.7",
    "@orpc/zod": "1.15.7",
    "@solid-primitives/scheduled": "^1.5.1",
    "@solid-primitives/storage": "^4.3.3",
    "@solidjs/router": "^0.15.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-db-collection": "^0.2.0",
    "@tanstack/solid-db": "^0.1.1",
    "@tanstack/solid-query": "^5.83.1",
    "arctic": "^3.7.0",
    "astro": "^7.4.0",
    "debug": "^4.4.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "echarts": "^5.6.0",
    "fluid-tailwindcss": "^1.1.8",
    "googleapis": "^143.0.0",
    "ical-generator": "^8.1.1",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "reconnecting-websocket": "^4.4.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "solid-color": "^0.0.4",
    "solid-i18n": "^1.1.0",
    "solid-icons": "^1.1.0",
    "solid-js": "^1.9.13",
    "solid-markdown": "^2.0.14",
    "solid-qr-code": "^0.1.11",
    "solid-transition-group": "^0.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "tinybase": "^6.3.0",
    "yaml": "^2.8.0",
    "yjs": "^13.6.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@drzl/cli": "^0.1.0",
    "@drzl/generator-service": "^0.1.0",
    "@drzl/generator-zod": "^0.1.0",
    "@drzl/template-orpc-service": "^0.1.0",
    "@msw/cloudflare": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.6.2",
    "drizzle-kit": "^0.31.11",
    "msw": "^3.0.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "tinybase": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  }
}
