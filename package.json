{
  "name": "jj-community-page",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "node before.js && astro dev",
    "start": "astro dev --verbose",
    "build": "astro build",
    "check": "astro check",
    "sync": "astro sync",
    "preview": "astro build && wrangler dev --port 3000",
    "astro": "astro",
    "cf:dev": "wrangler dev",
    "cf:deploy": "node before.js && npm run build && wrangler deploy --env prod",
    "cf:deploy:beta": "node before.js && npm run build && wrangler deploy --env beta",
    "cf:typegen": "wrangler types",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:d1:local": "bash ./run_local_migration.sh",
    "drizzle:d1": "bash ./run_migration.sh",
    "deployCurrentScheduletoFirestore": "node deployCurrentScheduleToFirestore.js",
    "updateTwitchUser": "node updateTwitchUser.js",
    "openapi-generator-cli:tiltify": "openapi-generator-cli generate -i ./src/lib/externalAPI/tiltify/spec.json -g typescript-fetch -o ./src/lib/externalAPI/tiltify/api/ --additional-properties=npmName=tiltify"
  },
  "dependencies": {
