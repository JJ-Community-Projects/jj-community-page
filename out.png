  console.log('init')
  const feedbackLocalstorage = window.localStorage;
  const button = document.getElementById("feedback-2024-banner-banner-got-it");

  const shouldShow = feedbackLocalstorage.getItem('feedback-2024-banner') ?? 'true';
  console.log('shouldShow', shouldShow);
  if (shouldShow === 'true') {
    const banner = document.getElementById('feedback-2024-banner')
    if (banner) {
      banner.classList.remove('hidden');
      banner.classList.add('flex');
    }
    button.addEventListener('click', () => {
      feedbackLocalstorage.setItem('feedback-2024-banner', 'false');
      document.getElementById('feedback-2024-banner').remove();
      window.gtag('event', 'dismiss_' + 'feedback-2024-banner');
    });
  }
</script> <div class="flex flex-col justify-start items-center min-h-screen"> <div class="w-full max-w-4xl mx-auto flex flex-col justify-start items-stretch [&>*]:w-full"> <pre>ERROR: {
